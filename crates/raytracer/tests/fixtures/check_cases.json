{
  "_comment": "Scene checks shared by `silicium-raytracer check` (Network/crates/raytracer/tests/check_cases.rs) and the site (FrontEnd/tests/sceneCheck.test.ts, which keeps an identical copy). Each case lists every issue expected, as code@line (line 0 = whole scene). Change both copies together.",
  "cases": [
    {
      "name": "valid scene",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "  position = { x = 0 y = 0 z = 0 }",
        "  fieldOfView = 60",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 color = { r = 255 g = 0 b = 0 } }",
        "  plane = { x = 0 y = 0 z = -1 normal_x = 0 normal_y = 0 normal_z = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 intensity = 400 }",
        "};"
      ],
      "expected": []
    },
    {
      "name": "typo in a key",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "  position = { x = 0 y = 0 z = 0 }",
        "  fieldOfView = 60",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radus = 1 color = { r = 255 g = 0 b = 0 } }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 intensity = 400 }",
        "};"
      ],
      "expected": [
        {
          "code": "unknown_key",
          "line": 7,
          "key": "radus",
          "suggestion": "radius"
        }
      ]
    },
    {
      "name": "key in the wrong case",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "  position = { x = 0 y = 0 z = 0 }",
        "  fieldofview = 60",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "unknown_key",
          "line": 4,
          "key": "fieldofview",
          "suggestion": "fieldOfView"
        }
      ]
    },
    {
      "name": "no resolution",
      "lines": [
        "camera : {",
        "  position = { x = 0 y = 0 z = 0 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "missing_resolution",
          "line": 1
        }
      ]
    },
    {
      "name": "height written before width",
      "lines": [
        "camera : {",
        "  resolution = { height = 32 width = 64 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "resolution_mismatch",
          "line": 2
        }
      ]
    },
    {
      "name": "value that is not a number",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = big }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "not_a_number",
          "line": 5,
          "key": "radius"
        }
      ]
    },
    {
      "name": "block never closed",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }"
      ],
      "expected": [
        {
          "code": "unbalanced_braces",
          "line": 7
        }
      ]
    },
    {
      "name": "extra closing brace",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "}};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "unbalanced_braces",
          "line": 3
        }
      ]
    },
    {
      "name": "values outside their range",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "  fieldOfView = 200",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 reflection = 2 color = { r = 300 g = 0 b = 0 } }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 intensity = -5 }",
        "};"
      ],
      "expected": [
        {
          "code": "out_of_range",
          "line": 3,
          "key": "fieldOfView"
        },
        {
          "code": "out_of_range",
          "line": 6,
          "key": "reflection"
        },
        {
          "code": "out_of_range",
          "line": 6,
          "key": "r"
        },
        {
          "code": "out_of_range",
          "line": 9,
          "key": "intensity"
        }
      ]
    },
    {
      "name": "no light and no object",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "};"
      ],
      "expected": [
        {
          "code": "empty_scene",
          "line": 0
        },
        {
          "code": "no_light",
          "line": 0
        }
      ]
    },
    {
      "name": "sphere behind the camera",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "};",
        "primitives : {",
        "  sphere = { x = -5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "behind_camera",
          "line": 5
        }
      ]
    },
    {
      "name": "features the renderer does not have",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "  cylinder = { x = 5 y = 2 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  ambient = 0.4",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "unsupported",
          "line": 6,
          "key": "cylinder"
        },
        {
          "code": "unsupported",
          "line": 9,
          "key": "ambient"
        }
      ]
    },
    {
      "name": "camera rotation written before its position",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "  rotation = { x = 0 y = 0 z = 30 }",
        "  position = { x = 1 y = 0 z = 0 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "camera_orientation_ignored",
          "line": 3
        },
        {
          "code": "camera_position_shadowed",
          "line": 3
        }
      ]
    },
    {
      "name": "assignment inside a comment",
      "lines": [
        "camera : {",
        "  # width = 999",
        "  resolution = { width = 64 height = 32 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "comment_assignment",
          "line": 2
        },
        {
          "code": "resolution_mismatch",
          "line": 3
        }
      ]
    },
    {
      "name": "plane without a normal",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "};",
        "primitives : {",
        "  plane = { x = 0 y = 0 z = -1 normal_x = 0 normal_y = 0 normal_z = 0 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "zero_normal",
          "line": 5
        }
      ]
    },
    {
      "name": "key given twice",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 radius = 2 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "duplicate_key",
          "line": 5,
          "key": "radius"
        }
      ]
    },
    {
      "name": "reflection and reflectivity together",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 reflection = 0.2 reflectivity = 0.5 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "duplicate_reflection",
          "line": 5,
          "key": "reflectivity"
        }
      ]
    },
    {
      "name": "colon instead of equals",
      "lines": [
        "camera : {",
        "  resolution = { width = 64 height = 32 }",
        "  fieldOfView : 60",
        "};",
        "primitives : {",
        "  sphere = { x = 5 y = 0 z = 0 radius = 1 }",
        "};",
        "lights : {",
        "  point = { x = 2 y = -2 z = 4 }",
        "};"
      ],
      "expected": [
        {
          "code": "use_equals",
          "line": 3,
          "key": "fieldOfView"
        }
      ]
    },
    {
      "name": "libconfig scene from another raytracer",
      "lines": [
        "camera : {",
        "  resolution = { width = 64; height = 32; };",
        "  position = { x = 0; y = 0; z = 0; };",
        "  fieldOfView = 60.0;",
        "};",
        "primitives : {",
        "  spheres = ( { x = 5; y = 0; z = 0; r = 1; color = { r = 255; g = 0; b = 0; }; } );",
        "};",
        "lights : {",
        "  ambient = 0.4;",
        "  point = ( { x = 2; y = -2; z = 4; } );",
        "};"
      ],
      "expected": [
        {
          "code": "unknown_block",
          "line": 7,
          "key": "spheres",
          "suggestion": "sphere"
        },
        {
          "code": "unsupported",
          "line": 10,
          "key": "ambient"
        },
        {
          "code": "empty_scene",
          "line": 0
        }
      ]
    }
  ]
}
