{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silicium.network/schemas/workload-manifest-v1.schema.json",
  "title": "Silicium Workload Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "engine",
    "command",
    "resources",
    "artifacts",
    "validation",
    "payment"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(calcul|verification)\\/[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "engine": {
      "type": "string",
      "enum": [
        "container",
        "python",
        "native"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "gpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/artifactList"
        },
        "output": {
          "$ref": "#/$defs/artifactList"
        }
      }
    },
    "validation": {
      "type": "object",
      "minProperties": 1
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "estimated_cost"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "estimated_cost": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "artifactList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
