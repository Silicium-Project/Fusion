{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silicium.network/schemas/workload-manifest-v1.schema.json",
  "title": "Silicium Workload Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "engine",
    "command",
    "resources",
    "taxonomy",
    "artifacts",
    "validation",
    "payment"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(calcul|verification)\\/[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "engine": {
      "type": "string",
      "enum": [
        "container",
        "python",
        "native"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "gpu",
        "memory",
        "budget"
      ],
      "properties": {
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_sec",
            "cpu_sec",
            "memory"
          ],
          "properties": {
            "wall_sec": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cpu_sec": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
            }
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "domain",
        "complexity",
        "resource_profile",
        "determinism",
        "tags"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "calcul",
            "verification"
          ]
        },
        "domain": {
          "type": "string",
          "enum": [
            "compression",
            "integrity",
            "math",
            "ml",
            "rendering",
            "simulation",
            "statistics",
            "video"
          ]
        },
        "complexity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "resource_profile": {
          "type": "string",
          "enum": [
            "cpu_light",
            "cpu_heavy",
            "gpu_optional",
            "gpu_required",
            "memory_light",
            "memory_heavy"
          ]
        },
        "determinism": {
          "type": "string",
          "enum": [
            "deterministic",
            "bounded_stochastic",
            "stochastic"
          ]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "audit",
              "compression",
              "cpu",
              "deterministic",
              "embeddings",
              "gpu",
              "hash",
              "libm",
              "math",
              "ml",
              "monte_carlo",
              "rendering",
              "simulation",
              "spotcheck",
              "statistics",
              "stochastic",
              "non_deterministic",
              "transcoding",
              "verification"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "determinism": {
                "const": "deterministic"
              }
            },
            "required": [
              "determinism"
            ]
          },
          "then": {
            "properties": {
              "tags": {
                "contains": {
                  "const": "deterministic"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "determinism": {
                "const": "bounded_stochastic"
              }
            },
            "required": [
              "determinism"
            ]
          },
          "then": {
            "properties": {
              "tags": {
                "contains": {
                  "const": "stochastic"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "determinism": {
                "const": "stochastic"
              }
            },
            "required": [
              "determinism"
            ]
          },
          "then": {
            "properties": {
              "tags": {
                "contains": {
                  "const": "stochastic"
                }
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/artifactList"
        },
        "output": {
          "$ref": "#/$defs/artifactList"
        }
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "vars"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "vars": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "minProperties": 1
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "estimated_cost"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "estimated_cost": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "artifactList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
