{
  "id": "cpp.pragma_once_header",
  "description": "Require exactly one #pragma once in headers.",
  "severity": "error",
  "kind": "pattern_count",
  "sanitize": "cpp",
  "scope": {
    "include": [
      "**/*.hpp",
      "**/*.h"
    ]
  },
  "patterns": [
    {
      "label": "#pragma once",
      "regex": "(?m)^\\s*#\\s*pragma\\s+once\\b",
      "min": 1,
      "max": 1
    }
  ]
}
