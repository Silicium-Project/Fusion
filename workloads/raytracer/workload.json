{
  "schema_version": 1,
  "id": "raytracer",
  "name": "Silicium Raytracer Workload",
  "description": "Distributed native Rust raytracer with deterministic tiles, recursive reflections, shadows, specular highlights and CPU multithreading.",
  "input": {
    "kind": "scene",
    "format": "raytracer-cfg",
    "default_example": "Network/workloads/raytracer/examples/demo-scene.cfg"
  },
  "output": {
    "fragment_format": "ppm/p6",
    "result_format": "png"
  },
  "workload_ids": {
    "compute": "calcul/rendering/raytracer",
    "verify": "verification/rendering/raytracer",
    "fragment_compute": "calcul/rendering/raytracer-fragment",
    "fragment_verify": "verification/rendering/raytracer-fragment"
  },
  "entrypoints": {
    "split": "python split.py <scene.cfg> --output <split.json>",
    "compute": "python compute.py --scene <scene.cfg> --output <fragment.ppm> --x-start <start> --x-end <end> --y-start <start> --y-end <end>",
    "verify": "python verify.py --scene <scene.cfg> --result <fragment.ppm> --expected-hash <sha256> --x-start <start> --x-end <end> --y-start <start> --y-end <end>",
    "reassemble": "python reassemble.py --fragment <fragment.ppm> --x-start <x> --y-start <y> --output <render.ppm> --png <render.png>"
  },
  "split_policy": {
    "kind": "center-out-neighbour-grid",
    "target_pixels_per_fragment": 120000,
    "max_fragments": 32
  },
  "verification_policy": {
    "strategy": "random-tile-row-milestone-v2",
    "default_batch_rows": 20,
    "samples_per_fragment": 1,
    "exclude_compute_worker": true
  },
  "portability": {
    "windows": true,
    "linux": true,
    "requires_gpu": false,
    "renderer": "rust-native",
    "multithreaded": true,
    "external_dependencies": ["optional SILICIUM_RAYTRACER_ASSETS_DIR"]
  }
}
