        "timeout_s": 300,
        "verification_batch_rows": 20
      },
      "path": "calcul/rendering/raytracer-fragment",
      "runtime": {
        "handler": "workloads.raytracer.node_tasks:compute_fragment",
        "kind": "python"
      },
      "version": "2.0.0"
    },
    {
      "id": "calcul/simulation/monte-carlo-pi",
