    {
      "id": "calcul/rendering/blender",
      "path": "calcul/rendering/blender",
      "runtime": {
        "kind": "planned"
      },
      "version": "0.2.0"
    },
    {
      "id": "calcul/rendering/raytracer-fragment",
      "parameters": {
        "orchestrator": "workloads/raytracer/run_network_job.py",
        "split_policy": {
          "kind": "center-out-neighbour-grid",
          "max_fragments": 32,
          "target_pixels_per_fragment": 120000
