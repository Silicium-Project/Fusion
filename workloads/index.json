      "parameters": {
        "default_batch_rows": 20,
        "exclude_compute_worker": true,
        "max_sample_rows": 256,
        "samples_per_fragment": 1,
        "strategy": "random-tile-row-milestone-v2"
      },
      "path": "verification/rendering/raytracer-fragment",
      "runtime": {
        "handler": "workloads.raytracer.node_tasks:verify_fragment_milestone",
        "kind": "python"
      },
      "version": "2.0.0"
    },
    {
