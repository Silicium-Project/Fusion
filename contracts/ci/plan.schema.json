{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silicium.network/contracts/ci/plan/v1",
  "title": "Silicium plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "source_sha",
    "policy_digest",
    "suites",
    "matrix",
    "paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "matrix": {
      "type": "object"
    }
  }
}
