            ./silicium start localnet "$@"
            ;;
        start-dev)
            ./silicium start devnet "$@"
            ;;
        start-test)
            ./silicium start testnet "$@"
            ;;
        start-main)
            ./silicium start mainnet "$@"
            ;;
        *)
            ./silicium "$cmd" "$@"
            ;;
    esac
}'''
    alias_snippet = f"""
# Silicium helper function
{function}
alias sl='silicium ledger list'
alias st='silicium test'
alias ss='silicium smoke'
alias sc='silicium clean cache'
alias sca='silicium clean all -y'
alias shist='silicium history show --tail 20'
alias sstart='silicium start localnet'
alias sstop='silicium stop'
"""

    rc_map = {
        "bash": "~/.bashrc",
        "zsh": "~/.zshrc",
        "fish": "~/.config/fish/config.fish",
    }
    path = args.path or rc_map.get(shell)
    if not path:
        print("Unsupported shell; provide --path to append manually.")
        return
    target = Path(path).expanduser()
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open("a", encoding="utf-8") as fh:
        fh.write("\n" + alias_snippet + "\n")
    print(f"Aliases appended to {target}")


def resolve_tui_frontend(requested: str | None) -> tuple[str, list[str]]:
    warnings: list[str] = []
    env_frontend = os.environ.get("SILICIUM_TUI_FRONTEND", "").strip().lower()
    candidate = (requested or env_frontend or "textual").strip().lower()
    if candidate not in TUI_FRONTENDS:
        warnings.append(
            f"Unsupported TUI frontend '{candidate}', falling back to textual "
            "(supported: textual, curses, headless)."
        )
        candidate = "textual"
    return candidate, warnings


def resolve_tui_connector(requested: str | None) -> tuple[str, list[str]]:
    warnings: list[str] = []
    env_connector = os.environ.get("SILICIUM_TUI_CONNECTOR", "").strip().lower()
    candidate = (requested or env_connector or "inprocess").strip().lower()
    if candidate not in TUI_CONNECTORS:
        warnings.append(
            f"Unsupported TUI connector '{candidate}', falling back to inprocess "
            "(supported: inprocess, stdio, http)."
        )
        candidate = "inprocess"
    return candidate, warnings


def run_tui_frontend(
    requested: str | None,
    requested_connector: str | None,
    ctx: Context,
    *,
    smoke: bool = False,
    strict_frontend: bool = False,
    headless_script: str | None = None,
    headless_timeout: float = 120.0,
    headless_json: str | None = None,
) -> None:
    from tools.tui.connectors import build_connector_registry
    from tools.tui.frontends import FrontendRunConfig, build_frontend_registry

    frontend, warnings = resolve_tui_frontend(requested)
    connector_name, connector_warnings = resolve_tui_connector(requested_connector)
    warnings.extend(connector_warnings)
    registry = build_frontend_registry()
    connector_registry = build_connector_registry()
    connector = connector_registry[connector_name]
    for warning in warnings:
        print(colorize(f"[WARN] {warning}", COLOR_YELLOW))

    if smoke:
        print(f"TUI frontend probe requested: {frontend}")
        if frontend == "headless":
            print("Frontend headless: OK")
            return
        if frontend == "curses":
            ok, reason = registry["curses"].probe()
            if ok:
                print("Frontend curses: OK")
                return
            print(colorize(f"[WARN] Frontend curses unavailable: {reason}", COLOR_YELLOW))
            if strict_frontend:
                sys.exit(1)
            print("Trying fallback frontend: textual")
            frontend = "textual"
        ok, reason = registry["textual"].probe()
        if ok:
            print("Frontend textual: OK")
            return
        print(colorize(f"[WARN] Frontend textual unavailable: {reason}", COLOR_YELLOW))
        if strict_frontend:
            sys.exit(1)
        print("Fallback frontend headless: OK")
        return

    if frontend == "headless":
        script_path = Path(headless_script).expanduser() if headless_script else None
        if script_path and not script_path.is_absolute():
            script_path = (REPO_ROOT / script_path).resolve()
        output_path = Path(headless_json).expanduser() if headless_json else None
        if output_path and not output_path.is_absolute():
            output_path = (REPO_ROOT / output_path).resolve()
        result = registry["headless"].run(
            FrontendRunConfig(
                headless_script=script_path,
                headless_timeout=headless_timeout,
                headless_json=output_path,
                connector=connector,
            )
        )
        if output_path and result.ok and not result.fallback_to_shell:
            print(f"Headless report written to {output_path}")
        if result.fallback_to_shell:
            print("Using TUI frontend: headless (shell mode).")
            launch_shell(ctx)
            return
        if not result.ok:
            print(colorize(f"[FAIL] {result.reason}", COLOR_YELLOW))
            sys.exit(1)
        if result.reason:
            print(result.reason)
        return

    if frontend == "curses":
        result = registry["curses"].run(FrontendRunConfig())
        if result.ok:
            return
        print(colorize(f"[WARN] {result.reason} Falling back to textual.", COLOR_YELLOW))

    result = registry["textual"].run(FrontendRunConfig(connector=connector))
    if result.ok:
        return

    if frontend == "textual":
        print(colorize(f"[WARN] {result.reason} Falling back to headless shell.", COLOR_YELLOW))
    else:
        print(colorize("[WARN] textual frontend unavailable. Falling back to headless shell.", COLOR_YELLOW))
    print("Install with: python -m pip install -r requirements-tui.txt")
    launch_shell(ctx)


def cmd_tui(args: argparse.Namespace, ctx: Context) -> None:
    run_tui_frontend(
        args.tui_frontend,
