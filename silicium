def run_core_check_in_docker(env_vars: dict[str, str], ctx: Context) -> None:
    ensure_docker_healthy(ctx, retries=2, timeout_s=8.0)
    image = ctx.config.core_check_image
    setup = ctx.config.core_check_setup
    if not setup:
        if image == CORE_CHECK_IMAGE_DEFAULT and CORE_CHECK_DOCKERFILE.exists():
            ensure_core_check_image(image, ctx)
            env_vars = dict(env_vars)
            env_vars.setdefault("PYTHON_BIN", "/opt/venv/bin/python")
            env_vars.setdefault("CPP_TEST_LOCAL", "1")
            env_vars.setdefault("SMOKE_MODE", "container")
            env_vars.setdefault("PROXY_TEST_MODE", "container")
            env_vars.setdefault("WORKSPACE_ROOT", str(REPO_ROOT).replace("\\", "/"))
            setup = "./ci/core_check.sh"
        else:
            setup = (
                "apt-get update && "
                "apt-get install -y --no-install-recommends "
                "build-essential python3 python3-pip libjansson-dev "
                "binutils pkg-config docker.io docker-compose-plugin ca-certificates && "
                "python3 -m pip install -r requirements-dev.txt && "
                "./ci/core_check.sh"
            )
    elif setup.strip() and setup.strip() != "./ci/core_check.sh":
        setup = f"{setup} && ./ci/core_check.sh"
    repo_mount = f"{REPO_ROOT}:/workspace"
    docker_cpus = env_vars.pop("CORE_CHECK_DOCKER_CPUS", "")
    docker_memory = env_vars.pop("CORE_CHECK_DOCKER_MEMORY", "")
    docker_memory_swap = env_vars.pop("CORE_CHECK_DOCKER_MEMORY_SWAP", "")
    cmd = [
        ctx.config.docker_bin,
        "run",
        "--rm",
    ]
    if docker_cpus:
        cmd += ["--cpus", docker_cpus]
    if docker_memory:
        cmd += ["--memory", docker_memory]
    if docker_memory_swap:
        cmd += ["--memory-swap", docker_memory_swap]
    cmd += [
        "-v",
        repo_mount,
        "-w",
        "/workspace",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "-e",
        "DEBIAN_FRONTEND=noninteractive",
    ]
    for key, value in env_vars.items():
        cmd += ["-e", f"{key}={value}"]
    cmd += [image, "bash", "-lc", setup]
    code = run(cmd, allow_failure=True)
    if code != 0:
        health = docker_health(ctx, retries=1, timeout_s=6.0)
        if not health.ok:
            print_docker_diagnostics(ctx, health)
        print(f"Core check failed in Docker with exit code {code}.")
        sys.exit(code)


def remove_path(path: Path) -> None:
    if not path.exists():
        return
    if path.is_dir():
        shutil.rmtree(path, ignore_errors=True)
    else:
        try:
            path.unlink()
        except FileNotFoundError:
            pass


