#!/usr/bin/env python3
"""
Silicium project helper CLI and interactive shell.

Entry point only: the implementation is the `tools.cli` package
(see tools/cli/README.md). This file ships with the desktop runtime, which
starts the node with `silicium node start`.
"""

from __future__ import annotations

import sys
from pathlib import Path

# `python path/to/silicium` puts this directory on sys.path; make it explicit so
# the script also works when loaded some other way (tests, runpy).
_NETWORK_ROOT = str(Path(__file__).resolve().parent)
if _NETWORK_ROOT not in sys.path:
    sys.path.insert(0, _NETWORK_ROOT)

from tools.cli.main import main  # noqa: E402

if __name__ == "__main__":
    main()
