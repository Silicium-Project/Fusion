def cmd_cpp_test(args: argparse.Namespace, ctx: Context) -> None:
    min_mem_mb_env = os.environ.get("SILICIUM_CPP_TEST_MIN_DOCKER_MEMORY_MB", "2048").strip()
    try:
        min_mem_mb = int(min_mem_mb_env)
    except ValueError:
        print(f"Invalid SILICIUM_CPP_TEST_MIN_DOCKER_MEMORY_MB value: {min_mem_mb_env}")
        sys.exit(1)
    min_mem_bytes = max(0, min_mem_mb) * 1024 * 1024
    ensure_docker_healthy(ctx, retries=2, timeout_s=8.0, min_memory_bytes=min_mem_bytes)
    image = args.image or ctx.config.cpp_test_image
    ensure_cpp_test_image(image, ctx)

    jobs = args.jobs
    if jobs is None:
        env_jobs = os.environ.get("SILICIUM_MAX_JOBS")
        if env_jobs:
            try:
                jobs = int(env_jobs)
            except ValueError:
                print(f"Invalid SILICIUM_MAX_JOBS value: {env_jobs}")
                sys.exit(1)
    jobs = jobs or 2

    use_ccache = args.use_ccache
    if use_ccache is None:
        env_cache = os.environ.get("SILICIUM_CPP_TEST_USE_CCACHE", "").strip().lower()
        if env_cache:
            use_ccache = env_cache in {"1", "true", "yes", "on"}
        else:
            use_ccache = False
    ccache_flag = "1" if use_ccache else "0"
    ccache_setup = "ccache -M 2G >/dev/null || true; " if use_ccache else ""
    env_force = os.environ.get("SILICIUM_CPP_TEST_FORCE_REBUILD", "").strip().lower()
    force_rebuild = env_force in {"1", "true", "yes", "on"}
    clean_target = "test-clean" if force_rebuild else "test-reset-counters"

    if args.scope == "worker":
        test_bin = "./build/tests/worker_tests"
        script = (
            "set -euo pipefail; "
            f"{ccache_setup}"
            f"cd /workspace && make -C executor JOBS={jobs}; "
            f"cd /workspace/worker && make {clean_target} && "
            f"make {test_bin} JOBS={jobs} CPP_TEST_JOBS={jobs} CPP_TEST_USE_CCACHE={ccache_flag}; "
            "if [ -n \"${GTEST_FILTER:-}\" ]; then "
            f"LD_LIBRARY_PATH=/workspace/executor {test_bin} --gtest_filter=\"$GTEST_FILTER\"; "
            "else "
            f"LD_LIBRARY_PATH=/workspace/executor {test_bin}; "
            "fi"
        )
    else:
        test_bin = "./build/tests/fragment_tests"
        script = (
            "set -euo pipefail; "
            f"{ccache_setup}"
            f"cd /workspace/executor && make {clean_target} && "
            f"make {test_bin} JOBS={jobs} CPP_TEST_JOBS={jobs} CPP_TEST_USE_CCACHE={ccache_flag}; "
            "if [ -n \"${GTEST_FILTER:-}\" ]; then "
            f"{test_bin} --gtest_filter=\"$GTEST_FILTER\"; "
            "else "
            f"{test_bin}; "
            "fi"
        )

    cmd = [
        ctx.config.docker_bin,
        "run",
        "--rm",
    ]
    if use_ccache:
        ccache_dir = REPO_ROOT / ".cache" / "cpp-tests" / "ccache"
        ccache_dir.mkdir(parents=True, exist_ok=True)
        cmd.extend(["-e", "CCACHE_DIR=/ccache"])
    if args.gtest_filter:
        cmd.extend(["-e", f"GTEST_FILTER={args.gtest_filter}"])
    cmd.extend(["-v", f"{REPO_ROOT}:/workspace"])
    if use_ccache:
        cmd.extend(["-v", f"{ccache_dir}:/ccache"])
    cmd += ["-w", "/workspace", image, "bash", "-lc", script]

    attempts = max(1, int(args.retry))
    timeout = float(args.timeout)
    for attempt in range(1, attempts + 1):
        pretty = " ".join(cmd)
        print(colorize(f">> {pretty}", COLOR_GREEN))
        try:
            result = subprocess.run(
                cmd,
                cwd=REPO_ROOT,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
            )
        except subprocess.TimeoutExpired:
            if attempt < attempts:
                print(
                    colorize(
                        f"[WARN] cpp-test timeout (attempt {attempt}/{attempts}), retrying...",
                        COLOR_YELLOW,
                    )
                )
                ensure_docker_healthy(ctx, retries=1, timeout_s=8.0)
                time.sleep(1.5 * attempt)
                continue
            print(
                f"C++ test run timed out after {args.timeout}s. "
                "Retry with a larger --timeout or narrower --gtest-filter."
            )
            sys.exit(124)
        except OSError as exc:
            print(f"Failed to launch Docker command: {exc}")
            sys.exit(1)

        if result.stdout:
            print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
        if result.returncode == 0:
            return

        combined = f"{result.stdout}\n{result.stderr}".lower()
        transient = (
            "unexpected eof" in combined
            or "internal server error" in combined
            or "_ping" in combined
            or "docker api" in combined
        )
        if transient and attempt < attempts:
            print(
                colorize(
                    f"[WARN] transient docker failure (attempt {attempt}/{attempts}), retrying...",
                    COLOR_YELLOW,
                )
            )
            ensure_docker_healthy(ctx, retries=1, timeout_s=8.0)
            time.sleep(1.5 * attempt)
            continue
        sys.exit(result.returncode)


def cmd_doctor(_: argparse.Namespace, ctx: Context) -> None:
    print(colorize("==> Silicium doctor", COLOR_YELLOW))
    print(f"os={os.name} python={sys.version.split()[0]}")
    print(f"docker_bin={ctx.config.docker_bin} DOCKER_HOST={os.environ.get('DOCKER_HOST', '<unset>')}")

    health = docker_health(ctx, retries=1, timeout_s=6.0)
    if health.ok:
        print(f"Docker: OK (server {health.detail or 'unknown'})")
    else:
        print(f"Docker: FAIL [{health.error_code}] {health.message}")
        if health.detail:
            detail = health.detail.strip().replace("\n", " | ")
            print(f"detail={detail[:800]}")

    if os.name != "nt":
        return

    distros = list_wsl_distros()
    if not distros:
        print("WSL: not available or no distributions found.")
        return

    print("WSL distros:")
    for distro in distros:
        flag = "*" if distro.get("default") == "yes" else " "
        print(f"  {flag} {distro['name']} (state={distro['state']} version={distro['version']})")

    default = next((d for d in distros if d.get("default") == "yes"), distros[0])
    name = default["name"]
    state = default.get("state", "")
    wsl_bin = shutil.which("wsl.exe") or shutil.which("wsl")
    if not wsl_bin:
        print("WSL: wsl.exe not found in PATH.")
        return

    if state.lower() != "running":
        print(f"WSL docker integration: unknown (distro '{name}' is {state}).")
        print("Tip: run `wsl -d <distro>` once, then re-run `python silicium doctor`.")
        return

    code, _, err = run_capture(
        [wsl_bin, "-d", name, "--", "sh", "-lc", "test -S /var/run/docker.sock"],
        timeout_s=5.0,
    )
    if code == 0:
        print(f"WSL docker integration: OK (socket present in '{name}')")
    else:
        detail = err.strip()
        print(f"WSL docker integration: FAIL (no socket in '{name}')")
        if detail:
            print(f"detail={detail[:800]}")
        print("Fix: Docker Desktop -> Settings -> Resources -> WSL Integration -> enable this distro.")

    code, _, _ = run_capture(
        [wsl_bin, "-d", name, "--", "sh", "-lc", "command -v docker >/dev/null 2>&1"],
        timeout_s=5.0,
    )
    if code != 0:
        print(f"WSL docker CLI: missing in '{name}' (install docker-cli or use Windows docker.exe).")


def cmd_check(args: argparse.Namespace, ctx: Context) -> None:
    if getattr(args, "docker_strict", False):
        args.full = True
        args.runner = "docker"
        args.docker = True
        args.require_docker = True

    scope = (args.scope or "all").lower()
    script = REPO_ROOT / "ci" / "core_check.sh"
    if not script.exists():
        print(f"Core check script not found: {script}")
        sys.exit(1)

    env_vars = {
        "CORE_CHECK_MODE": "full" if args.full else "quick",
        "CORE_CHECK_NATIVE": "1" if args.native else "0",
        "CORE_CHECK_RUN_DYNAMO": "1" if args.dynamo else "0",
        "CORE_CHECK_REQUIRE_DOCKER": "1" if args.require_docker else "0",
        "CORE_CHECK_SCOPE": scope,
    }
    jobs = args.jobs
    if jobs is None:
        env_jobs = os.environ.get("SILICIUM_MAX_JOBS")
        if env_jobs:
            try:
                jobs = int(env_jobs)
            except ValueError:
                print(f"Invalid SILICIUM_MAX_JOBS value: {env_jobs}")
                sys.exit(1)
    if jobs:
        env_vars["CORE_CHECK_JOBS"] = str(jobs)
    docker_cpus = args.docker_cpus or os.environ.get("SILICIUM_DOCKER_CPUS")
    if docker_cpus:
        env_vars["CORE_CHECK_DOCKER_CPUS"] = str(docker_cpus)
    docker_memory = args.docker_memory or os.environ.get("SILICIUM_DOCKER_MEMORY")
    if docker_memory:
        env_vars["CORE_CHECK_DOCKER_MEMORY"] = str(docker_memory)
    if args.docker is not None:
        env_vars["CORE_CHECK_WITH_DOCKER"] = "1" if args.docker else "0"
    if args.clean is not None:
        env_vars["CORE_CHECK_CLEAN"] = "1" if args.clean else "0"

    if args.python:
        if host_os_name() != "nt" or args.python.startswith("/"):
            env_vars["PYTHON_BIN"] = args.python

    if host_os_name() == "nt":
        runner = args.runner
        if runner == "auto":
            if docker_available(ctx):
                runner = "docker"
            elif wsl_available():
                runner = "wsl"
            else:
                print("Neither Docker nor WSL is available. Install Docker Desktop or WSL, or run on Linux.")
                sys.exit(1)

        if runner == "docker":
            env_vars.setdefault("CORE_CHECK_CLEAN", "0")
            if "CORE_CHECK_JOBS" not in env_vars:
                env_vars["CORE_CHECK_JOBS"] = "2"
            ensure_docker_healthy(ctx, retries=2, timeout_s=8.0)
            run_core_check_in_docker(env_vars, ctx)
            return

        if runner == "wsl" and not wsl_available():
            print("WSL is not available. Install WSL or use --runner docker.")
            sys.exit(1)

        bash = shutil.which("bash")
        if not bash:
            print("bash not found. Use Docker or install WSL to run core checks.")
            sys.exit(1)

        env_exports = " ".join(f"{k}={shlex.quote(v)}" for k, v in env_vars.items())
        try:
            wsl_path = subprocess.check_output(
                [bash, "-lc", f"wslpath -a {shlex.quote(str(script))}"],
                text=True,
            ).strip()
        except subprocess.CalledProcessError:
            print("WSL tooling (wslpath) not available. Install WSL or use --runner docker.")
            sys.exit(1)
        cmd = [bash, "-lc", f"{env_exports} {shlex.quote(wsl_path)}"]
        run(cmd)
        return

    if args.runner == "docker":
        ensure_docker_healthy(ctx, retries=2, timeout_s=8.0)
        run_core_check_in_docker(env_vars, ctx)
        return

    bash = shutil.which("bash")
    if not bash:
        print("bash not found. Install bash or use --runner docker.")
        sys.exit(1)

    env = os.environ.copy()
    env.update(env_vars)
    run([bash, str(script)], env=env)


