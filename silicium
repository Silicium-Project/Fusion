@dataclass(frozen=True)
class EnvConfig:
    docker_bin: str
    docker_compose_bin: str | None
    ledger_prefix: str
    core_check_image: str
    core_check_setup: str | None


@dataclass(frozen=True)
class Context:
    config: EnvConfig


@dataclass(frozen=True)
class CommandSpec:
    name: str
    help: str
    configure: Callable[[argparse.ArgumentParser], None]
    handler: Callable[[argparse.Namespace, Context], None]


@dataclass(frozen=True)
class CommandGroup:
    name: str
    help: str
    commands: list[CommandSpec]
    dest: str


class CommandRegistry:
    def __init__(self) -> None:
        self._commands: list[CommandSpec] = []
        self._groups: list[CommandGroup] = []

    def add(self, command: CommandSpec) -> None:
        self._commands.append(command)

    def add_group(self, group: CommandGroup) -> None:
        self._groups.append(group)

    def register(self, parser: argparse.ArgumentParser, ctx: Context) -> None:
        sub = parser.add_subparsers(dest="command", required=True)
        for command in self._commands:
            cmd_parser = sub.add_parser(command.name, help=command.help)
            command.configure(cmd_parser)
            cmd_parser.set_defaults(func=self._wrap(command.handler, ctx))
        for group in self._groups:
            group_parser = sub.add_parser(group.name, help=group.help)
            group_sub = group_parser.add_subparsers(dest=group.dest, required=True)
            for command in group.commands:
                cmd_parser = group_sub.add_parser(command.name, help=command.help)
                command.configure(cmd_parser)
                cmd_parser.set_defaults(func=self._wrap(command.handler, ctx))

    @staticmethod
    def _wrap(handler: Callable[[argparse.Namespace, Context], None], ctx: Context) -> Callable[[argparse.Namespace], None]:
        def _inner(args: argparse.Namespace) -> None:
            handler(args, ctx)
        return _inner


def load_env_config(env: Mapping[str, str] | None = None) -> EnvConfig:
    source = os.environ if env is None else env
    return EnvConfig(
        docker_bin=source.get("DOCKER", "docker"),
        docker_compose_bin=source.get("DOCKER_COMPOSE_BIN"),
        ledger_prefix=source.get("SILICIUM_LEDGER_PREFIX", "silicium"),
        core_check_image=source.get("SILICIUM_CORE_CHECK_IMAGE", CORE_CHECK_IMAGE_DEFAULT),
        core_check_setup=source.get("SILICIUM_CORE_CHECK_SETUP"),
    )


def build_context(env: Mapping[str, str] | None = None) -> Context:
    return Context(config=load_env_config(env))

COLOR_ENABLED = False
if colorama_init:
    colorama_init()
    COLOR_ENABLED = True
    COLOR_CYAN = Fore.CYAN
    COLOR_GREEN = Fore.GREEN
    COLOR_YELLOW = Fore.YELLOW
    COLOR_RESET = Style.RESET_ALL
else:  # pragma: no cover
    COLOR_CYAN = COLOR_GREEN = COLOR_YELLOW = COLOR_RESET = ""


def colorize(text: str, color: str) -> str:
    if not COLOR_ENABLED:
        return text
    return f"{color}{text}{COLOR_RESET}"


def run(cmd: list[str], *, cwd: Path | None = None, env: dict | None = None, allow_failure: bool = False) -> int:
    pretty = " ".join(cmd)
    print(colorize(f">> {pretty}", COLOR_GREEN))
    result = subprocess.run(cmd, cwd=cwd or REPO_ROOT, env=env, check=not allow_failure)
    if allow_failure and result.returncode:
        print(colorize(f"[WARN] Command failed but ignored (code {result.returncode})", COLOR_YELLOW))
    return result.returncode


def docker_available(ctx: Context) -> bool:
    if not shutil.which(ctx.config.docker_bin):
        return False
    try:
        subprocess.run(
            [ctx.config.docker_bin, "info"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
    except subprocess.SubprocessError:
        return False
    return True


def wsl_available() -> bool:
    if os.name != "nt":
        return False
    return bool(shutil.which("wsl.exe") or shutil.which("wsl"))


def compose_command(ctx: Context) -> list[str]:
    if ctx.config.docker_compose_bin:
        return shlex.split(ctx.config.docker_compose_bin)
    if shutil.which(ctx.config.docker_bin):
        try:
            subprocess.run(
                [ctx.config.docker_bin, "compose", "version"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
            )
            return [ctx.config.docker_bin, "compose"]
        except subprocess.SubprocessError:
            pass
    if shutil.which("docker-compose"):
        return ["docker-compose"]
    print("Docker Compose not available. Install Compose v2 or docker-compose, or set DOCKER_COMPOSE_BIN.")
    sys.exit(1)


def ensure_core_check_image(image: str, ctx: Context) -> None:
    if image != CORE_CHECK_IMAGE_DEFAULT or not CORE_CHECK_DOCKERFILE.exists():
        return
    try:
        subprocess.run(
            [ctx.config.docker_bin, "image", "inspect", image],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
        return
    except subprocess.SubprocessError:
        pass
    print(colorize(f">> Building {image} (core-check image)", COLOR_GREEN))
    run(
        [
            ctx.config.docker_bin,
            "build",
            "-t",
            image,
            "-f",
            str(CORE_CHECK_DOCKERFILE),
            str(REPO_ROOT),
        ]
    )


def run_core_check_in_docker(env_vars: dict[str, str], ctx: Context) -> None:
    image = ctx.config.core_check_image
    setup = ctx.config.core_check_setup
    if not setup:
        if image == CORE_CHECK_IMAGE_DEFAULT and CORE_CHECK_DOCKERFILE.exists():
            ensure_core_check_image(image, ctx)
            env_vars = dict(env_vars)
            env_vars.setdefault("PYTHON_BIN", "/opt/venv/bin/python")
            env_vars.setdefault("CPP_TEST_LOCAL", "1")
            env_vars.setdefault("SMOKE_MODE", "container")
            env_vars.setdefault("PROXY_TEST_MODE", "container")
            env_vars.setdefault("WORKSPACE_ROOT", str(REPO_ROOT).replace("\\", "/"))
            setup = "./ci/core_check.sh"
        else:
            setup = (
                "apt-get update && "
                "apt-get install -y --no-install-recommends "
                "build-essential python3 python3-pip libjansson-dev "
                "binutils pkg-config docker.io docker-compose-plugin ca-certificates && "
                "python3 -m pip install -r requirements-dev.txt && "
                "./ci/core_check.sh"
            )
    elif setup.strip() and setup.strip() != "./ci/core_check.sh":
        setup = f"{setup} && ./ci/core_check.sh"
    repo_mount = f"{REPO_ROOT}:/workspace"
    docker_cpus = env_vars.pop("CORE_CHECK_DOCKER_CPUS", "")
    docker_memory = env_vars.pop("CORE_CHECK_DOCKER_MEMORY", "")
    docker_memory_swap = env_vars.pop("CORE_CHECK_DOCKER_MEMORY_SWAP", "")
    cmd = [
        ctx.config.docker_bin,
        "run",
        "--rm",
    ]
    if docker_cpus:
        cmd += ["--cpus", docker_cpus]
    if docker_memory:
        cmd += ["--memory", docker_memory]
    if docker_memory_swap:
        cmd += ["--memory-swap", docker_memory_swap]
    cmd += [
        "-v",
        repo_mount,
        "-w",
        "/workspace",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "-e",
        "DEBIAN_FRONTEND=noninteractive",
    ]
    for key, value in env_vars.items():
        cmd += ["-e", f"{key}={value}"]
    cmd += [image, "bash", "-lc", setup]
    run(cmd)


def remove_path(path: Path) -> None:
    if not path.exists():
        return
    if path.is_dir():
        shutil.rmtree(path, ignore_errors=True)
    else:
        try:
            path.unlink()
        except FileNotFoundError:
            pass


def confirm(prompt: str) -> bool:
    reply = input(f"{colorize(prompt, COLOR_YELLOW)} [y/N] ").strip().lower()
    return reply in {"y", "yes"}


def resolve_service(name: str) -> tuple[str, str | None]:
    if name not in SERVICE_MAP:
        print(f"Unknown service '{name}'.")
        sys.exit(1)
    return SERVICE_MAP[name]


def compose_base(ctx: Context) -> list[str]:
    if not docker_available(ctx):
        print("Docker is not available or not running. Start Docker Desktop (or dockerd) and retry.")
        sys.exit(1)
    base = compose_command(ctx)
    if COMPOSE_ENV_FILE.exists():
        base += ["--env-file", str(COMPOSE_ENV_FILE)]
    base += ["-f", str(COMPOSE_FILE)]
    return base


def compose_up(service: str, profile: str | None, ctx: Context) -> None:
    cmd = compose_base(ctx)
    if profile:
        cmd += ["--profile", profile]
    cmd += ["up", "-d", service]
    run(cmd)


def compose_stop(service: str, profile: str | None, ctx: Context, remove: bool = False) -> None:
    cmd = compose_base(ctx)
    if profile:
        cmd += ["--profile", profile]
    cmd += ["stop", service]
    run(cmd)
    if remove:
        rm_cmd = compose_base(ctx)
        if profile:
            rm_cmd += ["--profile", profile]
        rm_cmd += ["rm", "-f", service]
        run(rm_cmd)


def compose_down(ctx: Context, volumes: bool = False) -> None:
    cmd = compose_base(ctx) + ["down"]
    if volumes:
        cmd.append("-v")
    run(cmd)


