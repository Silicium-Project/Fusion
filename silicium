@dataclass(frozen=True)
class EnvConfig:
    docker_bin: str
    docker_compose_bin: str | None
    ledger_prefix: str
    core_check_image: str
    core_check_setup: str | None
    cpp_test_image: str


@dataclass(frozen=True)
class Context:
    config: EnvConfig


@dataclass(frozen=True)
class CommandSpec:
    name: str
    help: str
    configure: Callable[[argparse.ArgumentParser], None]
    handler: Callable[[argparse.Namespace, Context], None]


@dataclass(frozen=True)
class CommandGroup:
    name: str
    help: str
    commands: list[CommandSpec]
    dest: str


@dataclass(frozen=True)
class DockerHealth:
    ok: bool
    error_code: str
    message: str
    detail: str = ""


class CommandRegistry:
    def __init__(self) -> None:
        self._commands: list[CommandSpec] = []
        self._groups: list[CommandGroup] = []

    def add(self, command: CommandSpec) -> None:
        self._commands.append(command)

    def add_group(self, group: CommandGroup) -> None:
        self._groups.append(group)

    def register(self, parser: argparse.ArgumentParser, ctx: Context) -> None:
        sub = parser.add_subparsers(dest="command", required=True)
        for command in self._commands:
            cmd_parser = sub.add_parser(command.name, help=command.help)
            command.configure(cmd_parser)
            cmd_parser.set_defaults(func=self._wrap(command.handler, ctx))
        for group in self._groups:
            group_parser = sub.add_parser(group.name, help=group.help)
            group_sub = group_parser.add_subparsers(dest=group.dest, required=True)
            for command in group.commands:
                cmd_parser = group_sub.add_parser(command.name, help=command.help)
                command.configure(cmd_parser)
                cmd_parser.set_defaults(func=self._wrap(command.handler, ctx))

    @staticmethod
    def _wrap(handler: Callable[[argparse.Namespace, Context], None], ctx: Context) -> Callable[[argparse.Namespace], None]:
        def _inner(args: argparse.Namespace) -> None:
            handler(args, ctx)
        return _inner


def load_env_config(env: Mapping[str, str] | None = None) -> EnvConfig:
    source = os.environ if env is None else env
    return EnvConfig(
        docker_bin=source.get("DOCKER", "docker"),
        docker_compose_bin=source.get("DOCKER_COMPOSE_BIN"),
        ledger_prefix=source.get("SILICIUM_LEDGER_PREFIX", "silicium"),
        core_check_image=source.get("SILICIUM_CORE_CHECK_IMAGE", CORE_CHECK_IMAGE_DEFAULT),
        core_check_setup=source.get("SILICIUM_CORE_CHECK_SETUP"),
        cpp_test_image=source.get("SILICIUM_CPP_TEST_IMAGE", CPP_TEST_IMAGE_DEFAULT),
    )


def build_context(env: Mapping[str, str] | None = None) -> Context:
    return Context(config=load_env_config(env))

