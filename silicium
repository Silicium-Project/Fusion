            dest="workload_cmd",
            commands=[
                CommandSpec("list", "List workloads", configure_workload_list, cmd_workload_list),
                CommandSpec("show", "Show a workload manifest", configure_workload_show, cmd_workload_show),
                CommandSpec("queue", "Generate a queue file from a summary.json", configure_workload_queue, cmd_workload_queue),
                CommandSpec("lint", "Validate workload manifests against schema", configure_workload_lint, cmd_workload_lint),
                CommandSpec(
                    "fixtures",
                    "Validate workload fixture integrity",
                    configure_workload_fixtures,
                    cmd_workload_fixtures,
                ),
                CommandSpec(
                    "alignment",
                    "Report workload to fixture alignment",
                    configure_workload_alignment,
                    cmd_workload_alignment,
                ),
                CommandSpec(
                    "golden",
                    "Validate deterministic golden corpus",
                    configure_workload_golden,
                    cmd_workload_golden,
                ),
            ],
        )
    )
    registry.add_group(
        CommandGroup(
            name="history",
            help="Inspect Silicium shell history",
            dest="history_cmd",
            commands=[
                CommandSpec("show", "Display history entries", configure_history_show, cmd_history_show),
                CommandSpec("clear", "Purge history file", configure_history_clear, cmd_history_clear),
            ],
        )
    )

    return registry


def build_parser(ctx: Context) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="silicium",
        description="Silicium CLI and shell",
    )
    registry = build_registry()
    registry.register(parser, ctx)
    return parser


def execute(argv: list[str], ctx: Context) -> None:
    parser = build_parser(ctx)
    args = parser.parse_args(argv)
    args.func(args)


def setup_readline(parser: argparse.ArgumentParser) -> None:
    if not readline:  # pragma: no cover - depends on platform
        return
    history_file = HISTORY_FILE
    try:
        history_file.touch(exist_ok=True)
    except OSError:
        history_file = None  # type: ignore
    else:
        try:
            readline.read_history_file(history_file)
        except OSError:
            pass
        def _save_history(file_path=history_file):
            try:
                readline.write_history_file(file_path)  # type: ignore[arg-type]
            except OSError as exc:
                print(f"Warning: unable to write history file: {exc}")

        atexit.register(_save_history)
    readline.set_history_length(1000)
    readline.parse_and_bind("tab: complete")

    def completer(text: str, state: int) -> str | None:
        buffer = readline.get_line_buffer()
        begidx = readline.get_begidx()
        prefix = buffer[:begidx]
        try:
            tokens = shlex.split(prefix)
        except ValueError:
            tokens = prefix.split()
        options = _completion_options(tokens, text)
        try:
            return options[state]
        except IndexError:
            return None

    readline.set_completer(completer)


def _completion_options(tokens: list[str], text: str) -> list[str]:
    if not tokens:
        return [cmd for cmd in TOP_LEVEL_COMMANDS if cmd.startswith(text)]
    first = tokens[0]
    subcommands = SUBCOMMANDS.get(first)
    if subcommands:
        if len(tokens) == 1:
            return [cmd for cmd in subcommands if cmd.startswith(text)]
    if first == "ledger":
        if len(tokens) == 1:
            return [cmd for cmd in SUBCOMMANDS["ledger"] if cmd.startswith(text)]
        sub = tokens[1]
        if sub == "wipe":
            opts = ["--network", "-n", "--all", "--yes", "-y"]
            if text.startswith("-"):
                return [opt for opt in opts if opt.startswith(text)]
            if tokens[-1] in {"--network", "-n"}:
                return [net for net in LEDGER_NETWORKS if net.startswith(text)]
            return [net for net in LEDGER_NETWORKS if net.startswith(text)]
        if sub == "export":
            opts = ["--output", "-o", "--force"]
            if len(tokens) <= 2:
                return [net for net in LEDGER_NETWORKS if net.startswith(text)]
            if text.startswith("-"):
                return [opt for opt in opts if opt.startswith(text)]
            if tokens[-1] in opts:
                return []
            return [net for net in LEDGER_NETWORKS if net.startswith(text)]
        if sub == "import":
            opts = ["--archive", "-y", "--yes"]
            if len(tokens) <= 2:
                return [net for net in LEDGER_NETWORKS if net.startswith(text)]
            if text.startswith("-"):
                return [opt for opt in opts if opt.startswith(text)]
            if tokens[-1] == "--archive":
                return []
            return [net for net in LEDGER_NETWORKS if net.startswith(text)]
        return []
    if first == "clean":
        if len(tokens) == 1:
            return [cmd for cmd in SUBCOMMANDS["clean"] if cmd.startswith(text)]
        flags = ["-y", "--yes", "--ledgers"]
        return [flag for flag in flags if flag.startswith(text)]
    if first == "setup":
        if len(tokens) == 1:
            return [cmd for cmd in SUBCOMMANDS["setup"] if cmd.startswith(text)]
        sub = tokens[1]
        if sub == "up":
            flags = ["--target", "--full", "--no-proxy", "--json"]
            if text.startswith("-"):
                return [flag for flag in flags if flag.startswith(text)]
            if tokens[-1] == "--target":
                return [opt for opt in SETUP_TARGET_CHOICES if opt.startswith(text)]
            return [opt for opt in SETUP_TARGET_CHOICES if opt.startswith(text)]
        if sub == "down":
            flags = ["--target", "-v", "--volumes", "--remove", "--json"]
            if text.startswith("-"):
                return [flag for flag in flags if flag.startswith(text)]
            if tokens[-1] == "--target":
                return [opt for opt in SETUP_TARGET_CHOICES if opt.startswith(text)]
            return [opt for opt in SETUP_TARGET_CHOICES if opt.startswith(text)]
        return []
    if first == "check":
        flags = [
            "--full",
            "--native",
            "--dynamo",
            "--docker",
            "--no-docker",
            "--require-docker",
            "--jobs",
            "--docker-cpus",
            "--docker-memory",
            "--python",
        ]
        return [flag for flag in flags if flag.startswith(text)]
    if first == "doctor":
        return []
    if first == "cpp-test":
        flags = [
            "--scope",
            "--gtest-filter",
            "--timeout",
            "--jobs",
            "--image",
        ]
        if text.startswith("-"):
            return [flag for flag in flags if flag.startswith(text)]
        if tokens[-1] == "--scope":
            return [opt for opt in ["worker", "executor"] if opt.startswith(text)]
        return []
    if first == "budget":
        flags = [
            "--budget-file",
            "--profile",
            "--all",
            "--strict",
            "--output",
            "--list",
        ]
        if text.startswith("-"):
            return [flag for flag in flags if flag.startswith(text)]
        if tokens[-1] == "--profile" and PERF_BUDGET_FILE.exists():
            try:
                raw = json.loads(PERF_BUDGET_FILE.read_text(encoding="utf-8"))
                profiles = raw.get("profiles", {})
                if isinstance(profiles, dict):
                    return [str(key) for key in profiles.keys() if str(key).startswith(text)]
            except Exception:
                return []
        return []
    if first == "history":
        if len(tokens) == 1:
            return [cmd for cmd in SUBCOMMANDS["history"] if cmd.startswith(text)]
        if tokens[1] == "show":
            return [flag for flag in ["--tail"] if flag.startswith(text)]
        return []
    if first == "start":
        if len(tokens) == 1:
            return [opt for opt in START_CHOICES if opt.startswith(text)]
        return []
    if first == "stop":
        choices = START_CHOICES + ["all"]
        if len(tokens) == 1:
            return [opt for opt in choices if opt.startswith(text)]
        return [flag for flag in ["-v", "--volumes", "--remove"] if flag.startswith(text)]
    if first == "workload":
        if len(tokens) == 1:
            return [cmd for cmd in SUBCOMMANDS["workload"] if cmd.startswith(text)]
        sub = tokens[1]
        taxonomy_flags = [
            "--category",
            "--domain",
            "--complexity",
            "--resource-profile",
            "--determinism",
            "--tag",
        ]
        if sub == "list":
            if text.startswith("-"):
                return [
                    flag
                    for flag in (["--tree", "--details", "--json"] + taxonomy_flags)
                    if flag.startswith(text)
                ]
            if tokens[-1] == "--category":
                return [value for value in WORKLOAD_TAXONOMY_CATEGORIES if value.startswith(text)]
            if tokens[-1] == "--domain":
                return [value for value in WORKLOAD_TAXONOMY_DOMAINS if value.startswith(text)]
            if tokens[-1] == "--complexity":
                return [value for value in WORKLOAD_TAXONOMY_COMPLEXITIES if value.startswith(text)]
            if tokens[-1] == "--resource-profile":
                return [value for value in WORKLOAD_TAXONOMY_RESOURCE_PROFILES if value.startswith(text)]
            if tokens[-1] == "--determinism":
                return [value for value in WORKLOAD_TAXONOMY_DETERMINISM if value.startswith(text)]
            if tokens[-1] == "--tag":
                return [value for value in WORKLOAD_TAXONOMY_TAGS if value.startswith(text)]
            return []
        if sub == "show":
            if text.startswith("-"):
                return [
                    flag
                    for flag in (["--readme", "--meta", "--dry-run", "--preset"] + taxonomy_flags)
                    if flag.startswith(text)
                ]
            if tokens[-1] == "--category":
                return [value for value in WORKLOAD_TAXONOMY_CATEGORIES if value.startswith(text)]
            if tokens[-1] == "--domain":
                return [value for value in WORKLOAD_TAXONOMY_DOMAINS if value.startswith(text)]
            if tokens[-1] == "--complexity":
                return [value for value in WORKLOAD_TAXONOMY_COMPLEXITIES if value.startswith(text)]
            if tokens[-1] == "--resource-profile":
                return [value for value in WORKLOAD_TAXONOMY_RESOURCE_PROFILES if value.startswith(text)]
            if tokens[-1] == "--determinism":
                return [value for value in WORKLOAD_TAXONOMY_DETERMINISM if value.startswith(text)]
            if tokens[-1] == "--tag":
                return [value for value in WORKLOAD_TAXONOMY_TAGS if value.startswith(text)]
            paths = workload_paths()
            return [p for p in paths if p.startswith(text)]
        if sub == "queue":
            opts = ["--summary", "--output"]
            if text.startswith("-"):
                return [opt for opt in opts if opt.startswith(text)]
            return []
        if sub == "lint":
            opts = ["--root", "--schema", "--json"]
            if text.startswith("-"):
                return [opt for opt in opts if opt.startswith(text)]
            return []
        if sub == "fixtures":
            opts = ["--json"]
            if text.startswith("-"):
                return [opt for opt in opts if opt.startswith(text)]
            return []
        if sub == "alignment":
            opts = ["--json", "--strict"]
            if text.startswith("-"):
                return [opt for opt in opts if opt.startswith(text)]
            return []
        if sub == "golden":
            opts = ["--corpus", "--json", "--strict"]
            if text.startswith("-"):
                return [opt for opt in opts if opt.startswith(text)]
            return []
        return []
    if first == "logs":
        if len(tokens) == 1:
            return [opt for opt in LOG_CHOICES if opt.startswith(text)]
        return [flag for flag in ["-f", "--follow"] if flag.startswith(text)]
    if first == "exec":
        if len(tokens) == 1:
            return [opt for opt in LOG_CHOICES if opt.startswith(text)]
        return [flag for flag in ["-u", "--user"] if flag.startswith(text)]
    if first == "tui":
        flags = [
            "--tui-frontend",
            "--tui-connector",
            "--smoke",
            "--strict-frontend",
            "--headless-script",
            "--headless-timeout",
            "--headless-json",
        ]
        if text.startswith("-"):
            return [flag for flag in flags if flag.startswith(text)]
        if tokens[-1] == "--tui-frontend":
            return [opt for opt in sorted(TUI_FRONTENDS) if opt.startswith(text)]
        if tokens[-1] == "--tui-connector":
            return [opt for opt in sorted(TUI_CONNECTORS) if opt.startswith(text)]
        return [opt for opt in sorted(TUI_FRONTENDS) if opt.startswith(text)]
    return []


def get_prompt() -> str:
    base = "silicium"
    if COLOR_ENABLED:
        return f"{COLOR_CYAN}{base}{COLOR_RESET} {colorize('>', COLOR_GREEN)} "
    return f"{base}> "


def launch_shell(ctx: Context) -> None:
    parser = build_parser(ctx)
    setup_readline(parser)
    print(
        colorize(
            "Silicium shell â€“ type 'help' for commands, 'exit' to quit.",
            COLOR_CYAN,
        )
    )
    prompt = get_prompt()
    while True:
        try:
            line = input(prompt).strip()
        except EOFError:
            print()
            break
        except KeyboardInterrupt:
            print()
            continue
        if not line:
            continue
        if line in {"exit", "quit"}:
            break
        if line in {"help", "?"}:
            parser.print_help()
            continue
        try:
            tokens = shlex.split(line)
        except ValueError as exc:
            print(f"Parse error: {exc}")
            continue
        try:
            args = parser.parse_args(tokens)
            args.func(args)
        except SystemExit:
            continue


def main(argv: list[str] | None = None) -> None:
    argv = sys.argv[1:] if argv is None else argv
    ctx = build_context()
    if not argv:
        run_tui_frontend(None, None, ctx)
        return
    try:
        execute(argv, ctx)
    except KeyboardInterrupt:
        print()
        sys.exit(1)


if __name__ == "__main__":
    main()
