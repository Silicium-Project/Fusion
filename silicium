    run(cmd)


def compose_stop(service: str, profile: str | None, ctx: Context, remove: bool = False, *, target: str = "") -> None:
    _emit_cli_event(
        "info",
        "dispatch_target",
        "Dispatching compose stop target",
        {
            "action": "compose_stop",
            "target": target or service,
            "service": service,
            "profile": profile or "",
            "remove": remove,
        },
    )
    cmd = compose_base(ctx)
    if profile:
        cmd += ["--profile", profile]
    cmd += ["stop", service]
    run(cmd)
    if remove:
