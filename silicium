def colorize(text: str, color: str) -> str:
    if not COLOR_ENABLED:
        return text
    return f"{color}{text}{COLOR_RESET}"


def run(cmd: list[str], *, cwd: Path | None = None, env: dict | None = None) -> None:
    pretty = " ".join(cmd)
    print(colorize(f">> {pretty}", COLOR_GREEN))
    subprocess.run(cmd, cwd=cwd or REPO_ROOT, env=env, check=True)


def remove_path(path: Path) -> None:
    if not path.exists():
        return
    if path.is_dir():
        shutil.rmtree(path, ignore_errors=True)
    else:
        try:
            path.unlink()
        except FileNotFoundError:
            pass


def confirm(prompt: str) -> bool:
    reply = input(f"{colorize(prompt, COLOR_YELLOW)} [y/N] ").strip().lower()
    return reply in {"y", "yes"}


def resolve_service(name: str) -> tuple[str, str | None]:
    if name not in SERVICE_MAP:
        print(f"Unknown service '{name}'.")
        sys.exit(1)
    return SERVICE_MAP[name]


def compose_base() -> list[str]:
    return [DOCKER_BIN, "compose", "-f", str(COMPOSE_FILE)]


def compose_up(service: str, profile: str | None = None) -> None:
    cmd = compose_base()
    if profile:
        cmd += ["--profile", profile]
    cmd += ["up", "-d", service]
    run(cmd)


def compose_stop(service: str, profile: str | None = None, remove: bool = False) -> None:
    cmd = compose_base()
    if profile:
        cmd += ["--profile", profile]
    cmd += ["stop", service]
    run(cmd)
    if remove:
        rm_cmd = compose_base()
        if profile:
            rm_cmd += ["--profile", profile]
        rm_cmd += ["rm", "-f", service]
        run(rm_cmd)


def compose_down(volumes: bool = False) -> None:
    cmd = compose_base() + ["down"]
    if volumes:
        cmd.append("-v")
    run(cmd)


