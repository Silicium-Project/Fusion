        "run",
        "--rm",
        "-v",
        f"{volume}:/data",
        "-v",
        f"{archive.parent}:/backup",
        "alpine",
        "sh",
        "-c",
        f"rm -rf /data/* && tar xzf /backup/{archive.name} -C /data",
    ]
    run(cmd)


def _read_workload_manifest(manifest_path: Path) -> dict[str, Any]:
    try:
        import yaml
    except ImportError:
        print("PyYAML is required for workload commands. Install with: python -m pip install pyyaml")
        sys.exit(1)
    try:
        data = yaml.safe_load(manifest_path.read_text(encoding="utf-8"))
    except Exception as exc:  # pragma: no cover - defensive
        print(f"Failed to parse manifest {manifest_path}: {exc}")
        sys.exit(1)
    if not isinstance(data, dict):
        print(f"Invalid manifest (expected mapping): {manifest_path}")
        sys.exit(1)
    return data


def _workload_entries() -> list[tuple[str, dict[str, Any]]]:
    entries: list[tuple[str, dict[str, Any]]] = []
    for path in workload_paths():
        manifest = WORKLOAD_ROOT / path / "manifest.yaml"
        entries.append((path, _read_workload_manifest(manifest)))
    return entries


def _workload_has_filters(args: argparse.Namespace) -> bool:
    return bool(
        args.category
        or args.domain
        or args.complexity
        or args.resource_profile
        or args.determinism
        or args.tag
    )


def _workload_filter_summary(args: argparse.Namespace) -> str:
    parts: list[str] = []
    if args.category:
        parts.append(f"category={args.category}")
    if args.domain:
        parts.append(f"domain={args.domain}")
    if args.complexity:
        parts.append(f"complexity={args.complexity}")
    if args.resource_profile:
        parts.append(f"resource_profile={args.resource_profile}")
    if args.determinism:
        parts.append(f"determinism={args.determinism}")
    if args.tag:
        parts.append("tags=" + ",".join(args.tag))
    return " ".join(parts)


def _workload_matches_filters(data: dict[str, Any], args: argparse.Namespace) -> bool:
    if not _workload_has_filters(args):
        return True
    taxonomy = data.get("taxonomy")
    if not isinstance(taxonomy, dict):
        return False
    if args.category and taxonomy.get("category") != args.category:
        return False
    if args.domain and taxonomy.get("domain") != args.domain:
        return False
    if args.complexity and taxonomy.get("complexity") != args.complexity:
        return False
    if args.resource_profile and taxonomy.get("resource_profile") != args.resource_profile:
        return False
    if args.determinism and taxonomy.get("determinism") != args.determinism:
        return False
    if args.tag:
        tags = taxonomy.get("tags", [])
        if not isinstance(tags, list):
            return False
        tag_set = {str(item) for item in tags}
        if not set(args.tag).issubset(tag_set):
            return False
    determinism = taxonomy.get("determinism")
    if determinism == "deterministic":
        tags = taxonomy.get("tags", [])
        tag_set = {str(item) for item in tags} if isinstance(tags, list) else set()
        if "deterministic" not in tag_set:
            return False
    if determinism in {"bounded_stochastic", "stochastic"}:
        tags = taxonomy.get("tags", [])
        tag_set = {str(item) for item in tags} if isinstance(tags, list) else set()
        if "stochastic" not in tag_set:
            return False
    return True


def _workload_presets(data: dict[str, Any]) -> list[dict[str, Any]]:
    presets = data.get("presets", [])
    if not isinstance(presets, list):
        return []
    valid: list[dict[str, Any]] = []
    for preset in presets:
        if isinstance(preset, dict):
            name = preset.get("name")
            vars_map = preset.get("vars", {})
            if isinstance(name, str) and name and isinstance(vars_map, dict):
                valid.append(preset)
    return valid


def _workload_preset_names(data: dict[str, Any]) -> list[str]:
    return [str(preset.get("name")) for preset in _workload_presets(data)]


def _select_preset(data: dict[str, Any], name: str | None) -> dict[str, Any] | None:
    presets = _workload_presets(data)
    if not presets:
        return None
    if name:
        for preset in presets:
            if preset.get("name") == name:
                return preset
        return None
    if len(presets) == 1:
        return presets[0]
    for preset in presets:
        if preset.get("name") == "default":
            return preset
    return None


def _extract_placeholders(command: str) -> list[str]:
    placeholders: list[str] = []
    formatter = string.Formatter()
    for _, field_name, _, _ in formatter.parse(command):
        if not field_name:
            continue
        name = field_name.split(".", 1)[0].split("[", 1)[0]
        if name not in placeholders:
            placeholders.append(name)
    return placeholders


def _render_command(command: str, variables: Mapping[str, Any]) -> str:
    rendered = command
    for key, value in variables.items():
        rendered = rendered.replace(f"{{{key}}}", str(value))
    return rendered


def _workload_metadata(path: str, data: dict[str, Any]) -> dict[str, Any]:
    resources = data.get("resources", {})
    taxonomy = data.get("taxonomy", {})
    presets = _workload_preset_names(data)
    return {
        "path": path,
        "id": data.get("id"),
        "engine": data.get("engine"),
        "resources": resources if isinstance(resources, dict) else {},
        "taxonomy": taxonomy if isinstance(taxonomy, dict) else {},
        "payment": data.get("payment", {}),
        "presets": presets,
    }


def _workload_dry_run_plan(path: str, manifest: Path, data: dict[str, Any], preset_name: str | None) -> dict[str, Any]:
    command = str(data.get("command") or "")
    preset = _select_preset(data, preset_name)
    variables = {}
    if preset:
        vars_map = preset.get("vars", {})
        if isinstance(vars_map, dict):
            variables = vars_map
    placeholders = _extract_placeholders(command)
    missing = [name for name in placeholders if name not in variables]
    plan = _workload_metadata(path, data)
    plan.update(
        {
            "manifest": str(manifest),
            "command": _render_command(command, variables),
            "placeholders": placeholders,
            "variables": variables,
            "missing_variables": missing,
            "preset": preset.get("name") if preset else None,
            "artifacts": data.get("artifacts", {}),
        }
    )
    return plan


def _schema_error_path(error: Any) -> str:
    path = getattr(error, "absolute_path", [])
    return "/".join(str(part) for part in path) or "<root>"


def lint_workload_manifests(root: Path, schema_path: Path) -> tuple[int, list[dict[str, str]]]:
    try:
        import yaml
    except ImportError:
        print("PyYAML is required for workload lint. Install with: python -m pip install pyyaml")
        sys.exit(1)
    try:
        from jsonschema import Draft202012Validator
    except ImportError:
        print("jsonschema is required for workload lint. Install with: python -m pip install jsonschema")
        sys.exit(1)
    if not root.exists():
        print(f"Workload root not found: {root}")
        sys.exit(1)
    if not schema_path.exists():
        print(f"Workload schema not found: {schema_path}")
        sys.exit(1)

    schema = json.loads(schema_path.read_text(encoding="utf-8"))
    validator = Draft202012Validator(schema)
    manifests = sorted(root.rglob("manifest.yaml"))
    errors: list[dict[str, str]] = []

    for manifest_path in manifests:
        try:
            data = yaml.safe_load(manifest_path.read_text(encoding="utf-8"))
        except Exception as exc:
            errors.append(
                {
                    "file": str(manifest_path),
                    "field": "<root>",
                    "rule": "yaml_parse",
                    "message": str(exc),
                }
            )
            continue

        if not isinstance(data, dict):
            errors.append(
                {
                    "file": str(manifest_path),
                    "field": "<root>",
                    "rule": "type",
                    "message": "manifest must be a YAML mapping",
                }
            )
            continue

        schema_errors = sorted(validator.iter_errors(data), key=lambda err: list(err.absolute_path))
        for error in schema_errors:
            errors.append(
                {
                    "file": str(manifest_path),
                    "field": _schema_error_path(error),
                    "rule": "schema_v1",
                    "message": error.message,
                }
            )

        relative = manifest_path.parent.relative_to(root)
        category = str(relative).replace("\\", "/").split("/", 1)[0]
        taxonomy = data.get("taxonomy", {})
        if isinstance(taxonomy, dict):
            taxonomy_category = taxonomy.get("category")
            if taxonomy_category is not None and taxonomy_category != category:
                errors.append(
                    {
                        "file": str(manifest_path),
                        "field": "taxonomy/category",
                        "rule": "taxonomy_category_match",
                        "message": f"expected '{category}', got '{taxonomy_category}'",
                    }
                )

    return len(manifests), errors


def cmd_workload_lint(args: argparse.Namespace, ctx: Context) -> None:
    root = Path(args.root).resolve()
    schema_path = Path(args.schema).resolve()
    checked, errors = lint_workload_manifests(root, schema_path)
    if args.json:
        print(
            json.dumps(
                {
                    "checked": checked,
                    "errors": errors,
                },
                indent=2,
            )
        )
    else:
        for error in errors:
            print(
                "[ERROR] "
                f"{error['file']} "
                f"field={error['field']} "
                f"rule={error['rule']} "
                f"message={error['message']}"
            )
        if errors:
            print(f"Validation failed: {len(errors)} error(s) across {checked} manifest(s).")
        else:
            print(f"All manifests valid: {checked} checked.")
    if errors:
        sys.exit(1)


def _fixture_index() -> dict[str, Any]:
    if not WORKLOAD_FIXTURES_INDEX.exists():
        print(f"Fixture index not found: {WORKLOAD_FIXTURES_INDEX}")
        sys.exit(1)
    try:
        raw = json.loads(WORKLOAD_FIXTURES_INDEX.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"Failed to parse fixture index: {exc}")
        sys.exit(1)
    if not isinstance(raw, dict):
        print("Fixture index must be a JSON object.")
        sys.exit(1)
    return raw


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _validate_fixtures(index: dict[str, Any]) -> dict[str, Any]:
    entries = index.get("entries", [])
    report = {
        "checked": 0,
        "passed": 0,
        "failed": 0,
        "errors": [],
    }
    if not isinstance(entries, list):
        report["errors"].append(
            {
                "fixture": "<index>",
                "field": "entries",
                "message": "entries must be a list",
            }
        )
        report["failed"] += 1
        return report

    for entry in entries:
        report["checked"] += 1
        if not isinstance(entry, dict):
            report["errors"].append(
                {"fixture": "<unknown>", "field": "<root>", "message": "entry must be object"}
            )
            report["failed"] += 1
            continue
        path = entry.get("path")
        fixture_id = entry.get("id", "<unknown>")
        sha_expected = entry.get("sha256")
        if not isinstance(path, str) or not path:
            report["errors"].append(
                {"fixture": fixture_id, "field": "path", "message": "path is required"}
            )
            report["failed"] += 1
            continue
        if not isinstance(sha_expected, str) or not sha_expected:
            report["errors"].append(
                {"fixture": fixture_id, "field": "sha256", "message": "sha256 is required"}
            )
            report["failed"] += 1
            continue
        fixture_path = WORKLOAD_FIXTURES_DIR / path
        if not fixture_path.exists():
            report["errors"].append(
                {
                    "fixture": fixture_id,
                    "field": "path",
                    "message": f"missing file: {fixture_path}",
                }
            )
            report["failed"] += 1
            continue
        actual = _sha256(fixture_path)
        if actual != sha_expected:
            report["errors"].append(
                {
                    "fixture": fixture_id,
                    "field": "sha256",
                    "message": f"hash mismatch for {path}",
                    "expected": sha_expected,
                    "actual": actual,
                }
            )
            report["failed"] += 1
            continue
        report["passed"] += 1
    return report


def cmd_workload_fixtures(args: argparse.Namespace, ctx: Context) -> None:
    index = _fixture_index()
    report = _validate_fixtures(index)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(
            f"Fixtures: {report['passed']} passed, "
            f"{report['failed']} failed, {report['checked']} checked."
        )
        for error in report["errors"]:
            fixture = error.get("fixture", "<unknown>")
            field = error.get("field", "<root>")
            message = error.get("message", "error")
            print(f"[ERROR] {fixture} field={field} message={message}")
    if report["failed"] > 0:
        sys.exit(1)


def _workload_family_from_id(workload_id: str) -> str:
    parts = workload_id.split("/")
    if len(parts) < 2:
        return workload_id
    return "/".join(parts[:2])


def _alignment_policy() -> dict[str, Any]:
    if not WORKLOAD_ALIGNMENT_POLICY.exists():
        return {"schema_version": 1, "critical_families": []}
    try:
        raw = json.loads(WORKLOAD_ALIGNMENT_POLICY.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"Failed to parse alignment policy: {exc}")
        sys.exit(1)
    if not isinstance(raw, dict):
        print("Alignment policy must be a JSON object.")
        sys.exit(1)
    return raw


def workload_alignment_report() -> dict[str, Any]:
    entries = _workload_entries()
    manifest_ids: list[str] = []
    for _, data in entries:
        workload_id = data.get("id")
        if isinstance(workload_id, str) and workload_id:
            manifest_ids.append(workload_id)
    families = sorted({_workload_family_from_id(workload_id) for workload_id in manifest_ids})

    fixture_index = _fixture_index()
    fixture_entries = fixture_index.get("entries", [])
    fixture_ids: list[str] = []
    if isinstance(fixture_entries, list):
        for entry in fixture_entries:
            if isinstance(entry, dict):
                fixture_id = entry.get("id")
                if isinstance(fixture_id, str) and fixture_id:
                    fixture_ids.append(fixture_id)

    covered_families = sorted({_workload_family_from_id(fixture_id) for fixture_id in fixture_ids})
    missing_families = sorted(set(families) - set(covered_families))

    policy = _alignment_policy()
    critical = policy.get("critical_families", [])
    critical_families = [value for value in critical if isinstance(value, str) and value]
    critical_missing = sorted(set(critical_families).intersection(set(missing_families)))

    return {
        "total_workloads": len(manifest_ids),
        "total_families": len(families),
        "families": families,
        "families_with_fixtures": covered_families,
        "missing_families": missing_families,
        "critical_families": sorted(critical_families),
        "critical_missing_families": critical_missing,
        "fixture_entries": len(fixture_ids),
    }


def cmd_workload_alignment(args: argparse.Namespace, ctx: Context) -> None:
    report = workload_alignment_report()
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(
            f"Workload alignment: {report['total_families'] - len(report['missing_families'])}/"
            f"{report['total_families']} families covered by fixtures."
        )
        if report["missing_families"]:
            print("Missing families:")
            for family in report["missing_families"]:
                print(f"  - {family}")
        else:
            print("No missing families.")
        if report["critical_missing_families"]:
            print("Critical missing families:")
            for family in report["critical_missing_families"]:
                print(f"  - {family}")
    if args.strict and report["critical_missing_families"]:
        sys.exit(1)


def _golden_corpus(path: Path) -> dict[str, Any]:
    if not path.exists():
        print(f"Golden corpus not found: {path}")
        sys.exit(1)
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"Failed to parse golden corpus: {exc}")
        sys.exit(1)
    if not isinstance(raw, dict):
        print("Golden corpus must be a JSON object.")
        sys.exit(1)
    return raw


def _golden_case_hash(plan: dict[str, Any], manifest_data: dict[str, Any]) -> str:
    material = {
        "engine": manifest_data.get("engine"),
        "command": plan.get("command"),
        "artifacts": manifest_data.get("artifacts", {}),
        "preset": plan.get("preset"),
    }
    encoded = json.dumps(material, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def workload_golden_report(corpus_path: Path) -> dict[str, Any]:
    corpus = _golden_corpus(corpus_path)
    cases = corpus.get("cases", [])
    report: dict[str, Any] = {
        "checked": 0,
        "passed": 0,
        "failed": 0,
        "errors": [],
    }
    if not isinstance(cases, list):
        report["errors"].append(
            {"case": "<corpus>", "field": "cases", "message": "cases must be a list"}
        )
        report["failed"] += 1
        return report

    entries = _workload_entries()
    by_id: dict[str, tuple[str, dict[str, Any]]] = {}
    for path, data in entries:
        workload_id = data.get("id")
        if isinstance(workload_id, str) and workload_id:
            by_id[workload_id] = (path, data)

    for case in cases:
        report["checked"] += 1
        if not isinstance(case, dict):
            report["failed"] += 1
            report["errors"].append(
                {"case": "<unknown>", "field": "<root>", "message": "case must be object"}
            )
            continue
        workload_id = case.get("id")
        preset = case.get("preset")
        expected_hash = case.get("expected_plan_hash")
        case_name = str(workload_id) if workload_id else "<unknown>"
        if not isinstance(workload_id, str) or not workload_id:
            report["failed"] += 1
            report["errors"].append(
                {"case": case_name, "field": "id", "message": "id is required"}
            )
            continue
        if not isinstance(expected_hash, str) or not expected_hash:
            report["failed"] += 1
            report["errors"].append(
                {
                    "case": case_name,
                    "field": "expected_plan_hash",
                    "message": "expected_plan_hash is required",
                }
            )
            continue
        if workload_id not in by_id:
            report["failed"] += 1
            report["errors"].append(
                {
                    "case": case_name,
                    "field": "id",
                    "message": f"workload id not found: {workload_id}",
                }
            )
            continue

        path, manifest_data = by_id[workload_id]
        taxonomy = manifest_data.get("taxonomy", {})
        determinism = taxonomy.get("determinism") if isinstance(taxonomy, dict) else None
        if determinism != "deterministic":
            report["failed"] += 1
            report["errors"].append(
                {
                    "case": case_name,
                    "field": "taxonomy.determinism",
                    "message": f"golden corpus requires deterministic workload, got {determinism}",
                }
            )
            continue

        manifest_path = WORKLOAD_ROOT / path / "manifest.yaml"
        plan = _workload_dry_run_plan(
            path,
            manifest_path,
            manifest_data,
            preset if isinstance(preset, str) else None,
        )
        missing = plan.get("missing_variables", [])
        if isinstance(missing, list) and missing:
            report["failed"] += 1
            report["errors"].append(
                {
                    "case": case_name,
                    "field": "missing_variables",
                    "message": f"missing variables: {', '.join(str(value) for value in missing)}",
                }
            )
            continue
        actual_hash = _golden_case_hash(plan, manifest_data)
        if actual_hash != expected_hash:
            report["failed"] += 1
            report["errors"].append(
                {
                    "case": case_name,
                    "field": "expected_plan_hash",
                    "message": "plan hash mismatch",
                    "expected": expected_hash,
                    "actual": actual_hash,
                }
            )
            continue
        report["passed"] += 1
    return report


def cmd_workload_golden(args: argparse.Namespace, ctx: Context) -> None:
    corpus_path = Path(args.corpus).resolve()
    report = workload_golden_report(corpus_path)
    if args.json:
