class CommandRegistry:
    def __init__(self) -> None:
        self._commands: list[CommandSpec] = []
        self._groups: list[CommandGroup] = []

    def add(self, command: CommandSpec) -> None:
        self._commands.append(command)

    def add_group(self, group: CommandGroup) -> None:
        self._groups.append(group)

    def register(self, parser: argparse.ArgumentParser, ctx: Context) -> None:
        sub = parser.add_subparsers(dest="command", required=True)
        for command in self._commands:
            cmd_parser = sub.add_parser(command.name, help=command.help)
            command.configure(cmd_parser)
            cmd_parser.set_defaults(func=self._wrap(command.handler, ctx))
        for group in self._groups:
            group_parser = sub.add_parser(group.name, help=group.help)
            group_sub = group_parser.add_subparsers(dest=group.dest, required=True)
            for command in group.commands:
                cmd_parser = group_sub.add_parser(command.name, help=command.help)
                command.configure(cmd_parser)
                cmd_parser.set_defaults(func=self._wrap(command.handler, ctx))

    @staticmethod
    def _wrap(handler: Callable[[argparse.Namespace, Context], None], ctx: Context) -> Callable[[argparse.Namespace], None]:
        def _inner(args: argparse.Namespace) -> None:
            global _ACTIVE_CLI_LOGGER

            run_id = _generate_run_id()
            configured_log = os.environ.get(CLI_STRUCTURED_LOG_ENV, "").strip()
            log_path = Path(configured_log).expanduser() if configured_log else _default_cli_structured_log_path(run_id)
            logger = StructuredRunLogger(component="cli", run_id=run_id, path=log_path)
            previous_logger = _ACTIVE_CLI_LOGGER
            _ACTIVE_CLI_LOGGER = logger

            command = getattr(args, "command", "") or ""
            subcommands = [
                value
                for key, value in sorted(vars(args).items())
                if key.endswith("_cmd") and isinstance(value, str) and value
            ]
            command_path = " ".join([command, *subcommands]).strip()
            payload_base = {
                "command": command,
                "command_path": command_path,
                "subcommands": subcommands,
                "cwd": str(Path.cwd()),
            }

            previous_env = {
                "SILICIUM_RUN_ID": os.environ.get("SILICIUM_RUN_ID"),
                "EXECUTOR_RUN_ID": os.environ.get("EXECUTOR_RUN_ID"),
                "WORKER_RUN_ID": os.environ.get("WORKER_RUN_ID"),
            }
            os.environ["SILICIUM_RUN_ID"] = run_id
            os.environ["EXECUTOR_RUN_ID"] = run_id
            os.environ["WORKER_RUN_ID"] = run_id

            started_at = time.monotonic()
            _emit_cli_event("info", "command_started", "CLI command started", payload_base)
            try:
                handler(args, ctx)
            except SystemExit as exc:
                code = exc.code if isinstance(exc.code, int) else (0 if exc.code in (None, "") else 1)
                payload = {
                    **payload_base,
                    "exit_code": int(code),
                    "duration_ms": int((time.monotonic() - started_at) * 1000),
                }
                _emit_cli_event(
                    "info" if int(code) == 0 else "error",
                    "command_finished",
                    "CLI command completed" if int(code) == 0 else "CLI command failed",
                    payload,
                )
                raise
            except Exception as exc:
                payload = {
                    **payload_base,
                    "exit_code": 1,
                    "duration_ms": int((time.monotonic() - started_at) * 1000),
                    "error": str(exc),
                }
                _emit_cli_event("error", "command_finished", "CLI command failed", payload)
                raise
            else:
                payload = {
                    **payload_base,
                    "exit_code": 0,
                    "duration_ms": int((time.monotonic() - started_at) * 1000),
                }
                _emit_cli_event("info", "command_finished", "CLI command completed", payload)
            finally:
                for key, value in previous_env.items():
                    if value is None:
                        os.environ.pop(key, None)
                    else:
                        os.environ[key] = value
                _ACTIVE_CLI_LOGGER = previous_logger
                logger.close()
        return _inner


def _load_json_file(path: Path) -> dict[str, Any]:
    try:
        if not path.exists():
            return {}
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _resolve_config_file() -> Path:
    override = os.environ.get("SILICIUM_CONFIG", "").strip()
    if override:
        return Path(override)
    return DEFAULT_CONFIG_FILE


def _resolve_repo_path(value: str, base: Path = REPO_ROOT) -> Path:
    p = Path(value)
    if p.is_absolute():
        return p
    return base / p


def _ensure_token_file(path: Path) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        return path.read_text(encoding="utf-8").strip()
    token = secrets.token_urlsafe(32)
    path.write_text(token, encoding="utf-8")
    return token


def _resolve_mcp_settings(args: argparse.Namespace) -> dict[str, Any]:
    cfg = _load_json_file(_resolve_config_file()).get("mcp", {})
    if not isinstance(cfg, dict):
        cfg = {}

    bind = getattr(args, "bind", "") or os.environ.get("SILICIUM_MCP_BIND", "") or str(cfg.get("bind") or MCP_DEFAULT_BIND)
    port = getattr(args, "port", 0) or int(os.environ.get("SILICIUM_MCP_PORT", "0") or 0) or int(cfg.get("port") or MCP_DEFAULT_PORT)

    export_dir_value = (
        getattr(args, "export_dir", "")
        or os.environ.get("SILICIUM_MCP_EXPORT_DIR", "")
        or str(cfg.get("export_dir") or MCP_DEFAULT_EXPORT_DIR)
    )
    export_dir = _resolve_repo_path(export_dir_value) if export_dir_value else MCP_DEFAULT_EXPORT_DIR

    token_file_value = os.environ.get("SILICIUM_MCP_TOKEN_FILE", "") or str(cfg.get("token_file") or MCP_DEFAULT_TOKEN_FILE)
    token_file = _resolve_repo_path(token_file_value)

    enable_tools = bool(getattr(args, "enable_tools", False))
    if not getattr(args, "enable_tools", False):
        env_enable = os.environ.get("SILICIUM_MCP_ENABLE_TOOLS", "").strip().lower()
        if env_enable:
            enable_tools = env_enable not in {"0", "false", "no"}
        else:
            enable_tools = bool(cfg.get("enable_tools") or False)

    def _split_csv(raw: str) -> list[str]:
        return [item.strip() for item in str(raw).split(",") if item.strip()]

    def _resolve_list_value(arg_name: str, env_name: str, cfg_name: str) -> list[str]:
        arg_raw = str(getattr(args, arg_name, "") or "").strip()
        if arg_raw:
            return _split_csv(arg_raw)
        env_raw = str(os.environ.get(env_name, "")).strip()
        if env_raw:
            return _split_csv(env_raw)
        cfg_raw = cfg.get(cfg_name, [])
        if isinstance(cfg_raw, str):
            return _split_csv(cfg_raw)
        if isinstance(cfg_raw, list):
            return [str(item).strip() for item in cfg_raw if str(item).strip()]
        return []

    no_auth = bool(getattr(args, "no_auth", False))
    token = ""
    if not no_auth:
        token = getattr(args, "token", "") or os.environ.get("SILICIUM_MCP_TOKEN", "") or _ensure_token_file(token_file)
    tool_allowlist = _resolve_list_value("tool_allowlist", "SILICIUM_MCP_TOOL_ALLOWLIST", "tool_allowlist")
    tool_denylist = _resolve_list_value("tool_denylist", "SILICIUM_MCP_TOOL_DENYLIST", "tool_denylist")
    resource_allowlist = _resolve_list_value("resource_allowlist", "SILICIUM_MCP_RESOURCE_ALLOWLIST", "resource_allowlist")
    resource_denylist = _resolve_list_value("resource_denylist", "SILICIUM_MCP_RESOURCE_DENYLIST", "resource_denylist")

    export_dir.mkdir(parents=True, exist_ok=True)
    return {
        "bind": bind,
        "port": port,
        "export_dir": str(export_dir),
        "token": token,
        "no_auth": no_auth,
        "enable_tools": enable_tools,
        "tool_allowlist": tool_allowlist,
        "tool_denylist": tool_denylist,
        "resource_allowlist": resource_allowlist,
        "resource_denylist": resource_denylist,
    }


