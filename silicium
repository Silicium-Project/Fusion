def workload_paths() -> list[str]:
    if not WORKLOAD_ROOT.exists():
        return []
    paths: list[str] = []
    for manifest in WORKLOAD_ROOT.rglob("manifest.yaml"):
        rel = manifest.parent.relative_to(WORKLOAD_ROOT)
        paths.append(str(rel).replace("\\", "/"))
    return sorted(paths)


def cmd_workload_list(args: argparse.Namespace, ctx: Context) -> None:
    paths = workload_paths()
    if not paths:
        print("No workloads found.")
        return
    if not args.tree:
        for path in paths:
            print(path)
        return

    def insert(node: dict, parts: list[str]) -> None:
        if not parts:
            return
        head, *tail = parts
        child = node.setdefault(head, {})
        insert(child, tail)

    tree: dict = {}
    for path in paths:
        insert(tree, path.split("/"))

    def print_tree(node: dict, depth: int = 0) -> None:
        for name in sorted(node):
            child = node[name]
            prefix = "  " * depth + "- "
            print(f"{prefix}{name}")
            print_tree(child, depth + 1)

    print_tree(tree)


def cmd_workload_show(args: argparse.Namespace, ctx: Context) -> None:
    manifest = WORKLOAD_ROOT / args.path / "manifest.yaml"
    if not manifest.exists():
        print(f"Manifest not found: {manifest}")
        sys.exit(1)
    print(colorize(f"==> {manifest}", COLOR_YELLOW))
    print(manifest.read_text(encoding="utf-8"))
    if args.readme:
        readme = manifest.with_name("README.md")
        if readme.exists():
            print(colorize(f"\n==> {readme}", COLOR_YELLOW))
            print(readme.read_text(encoding="utf-8"))
        else:
            print("No README.md for this workload.")


def cmd_workload_queue(args: argparse.Namespace, ctx: Context) -> None:
    summary = Path(args.summary)
    if not summary.exists():
        print(f"Summary not found: {summary}")
        sys.exit(1)
    try:
        data = json.loads(summary.read_text(encoding="utf-8"))
    except Exception as exc:  # pragma: no cover - defensive
        print(f"Failed to parse summary JSON: {exc}")
        sys.exit(1)

    partitions = data.get("partitions", [])
    ids = [p.get("id") for p in partitions if isinstance(p, dict) and p.get("id")]
    if not ids:
        print("No partitions found in summary.")
        sys.exit(1)

    dest = Path(args.output or summary.parent / "queue.txt")
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text("\n".join(ids) + "\n", encoding="utf-8")
    print(colorize(f"Wrote {len(ids)} entries to {dest}", COLOR_YELLOW))


def cmd_history_show(args: argparse.Namespace, ctx: Context) -> None:
    if not HISTORY_FILE.exists():
        print("No history entries yet.")
        return
    lines = HISTORY_FILE.read_text(encoding="utf-8").splitlines()
    tail = args.tail
    if tail:
        lines = lines[-tail:]
    for line in lines:
        print(line)


def cmd_history_clear(_: argparse.Namespace, ctx: Context) -> None:
    if HISTORY_FILE.exists():
        HISTORY_FILE.unlink()
    HISTORY_FILE.touch()
    if readline:
        readline.clear_history()  # type: ignore[arg-type]
    print("History cleared.")


def cmd_start(args: argparse.Namespace, ctx: Context) -> None:
    service, profile = START_TARGETS[args.target]
    compose_up(service, profile, ctx)


def cmd_stop(args: argparse.Namespace, ctx: Context) -> None:
    target = args.target or "all"
    if target == "all":
        compose_down(ctx, volumes=args.volumes)
    else:
        service, profile = START_TARGETS[target]
        compose_stop(service, profile, ctx, remove=args.remove)


def cmd_status(args: argparse.Namespace, ctx: Context) -> None:
    cmd = compose_base(ctx) + ["ps"]
    run(cmd)


def cmd_logs(args: argparse.Namespace, ctx: Context) -> None:
    service, profile = resolve_service(args.target)
    cmd = compose_base(ctx)
    if profile:
        cmd += ["--profile", profile]
    cmd += ["logs"]
    if args.follow:
        cmd.append("-f")
    cmd.append(service)
    run(cmd)


def cmd_exec(args: argparse.Namespace, ctx: Context) -> None:
    service_name, profile = resolve_service(args.service)
    cmd = compose_base(ctx) + ["exec"]
    if profile:
        cmd += ["--profile", profile]
    if args.user:
        cmd += ["-u", args.user]
    cmd.append(service_name)
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        command = ["/bin/bash"]
    cmd += command
    run(cmd)


def cmd_alias(args: argparse.Namespace, ctx: Context) -> None:
    shell = args.shell or "bash"
    function = '''silicium() {
    local cmd=$1
    shift
    case "$cmd" in
        test|smoke|clean|shell)
            ./silicium "$cmd" "$@"
            ;;
        tools)
            ./silicium tools "$@"
            ;;
        ledger)
            ./silicium ledger "$@"
            ;;
        history)
            ./silicium history "$@"
            ;;
        start)
            ./silicium start "$@"
            ;;
        stop)
            ./silicium stop "$@"
            ;;
        start-local)
            ./silicium start localnet "$@"
            ;;
        start-dev)
            ./silicium start devnet "$@"
            ;;
        start-test)
            ./silicium start testnet "$@"
            ;;
        start-main)
            ./silicium start mainnet "$@"
            ;;
        *)
            ./silicium "$cmd" "$@"
            ;;
    esac
}'''
    alias_snippet = f"""
# Silicium helper function
{function}
alias sl='silicium ledger list'
alias st='silicium test'
alias ss='silicium smoke'
alias sc='silicium clean cache'
alias sca='silicium clean all -y'
alias shist='silicium history show --tail 20'
alias sstart='silicium start localnet'
alias sstop='silicium stop'
"""

    rc_map = {
        "bash": "~/.bashrc",
        "zsh": "~/.zshrc",
        "fish": "~/.config/fish/config.fish",
    }
    path = args.path or rc_map.get(shell)
    if not path:
        print("Unsupported shell; provide --path to append manually.")
        return
    target = Path(path).expanduser()
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open("a", encoding="utf-8") as fh:
        fh.write("\n" + alias_snippet + "\n")
    print(f"Aliases appended to {target}")


