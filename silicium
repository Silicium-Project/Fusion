def get_prompt() -> str:
    base = tr("cli.shell.name")
    if COLOR_ENABLED:
        return f"{COLOR_CYAN}{base}{COLOR_RESET} {colorize('>', COLOR_GREEN)} "
    return f"{base}> "


def launch_shell(ctx: Context) -> None:
    parser = build_parser(ctx)
    setup_readline(parser)
    print(
        colorize(
            tr("cli.shell.banner"),
            COLOR_CYAN,
        )
    )
    prompt = get_prompt()
    while True:
        try:
            line = input(prompt).strip()
        except EOFError:
            print()
            break
        except KeyboardInterrupt:
            print()
            continue
        if not line:
            continue
        if line in {"exit", "quit"}:
            break
        if line in {"help", "?"}:
            parser.print_help()
            continue
        try:
            tokens = shlex.split(line)
        except ValueError as exc:
            print(tr("cli.shell.parse_error", str(exc)))
            continue
        try:
            args = parser.parse_args(tokens)
            set_runtime_locale(getattr(args, "locale", None))
            args.func(args)
        except SystemExit:
            continue


def main(argv: list[str] | None = None) -> None:
    argv = sys.argv[1:] if argv is None else argv
    ctx = build_context()
    if not argv:
        run_tui_frontend(None, None, ctx)
        return
    locale_only = None
    if len(argv) == 1 and argv[0].startswith("--locale="):
        locale_only = argv[0].split("=", 1)[1]
    elif len(argv) == 2 and argv[0] == "--locale":
        locale_only = argv[1]
    if locale_only is not None:
        set_runtime_locale(locale_only)
        run_tui_frontend(None, None, ctx)
        return
    try:
        execute(argv, ctx)
    except KeyboardInterrupt:
        print()
        sys.exit(1)


if __name__ == "__main__":
    main()
