    created = _node_solana_request(
        args,
        "create_job",
        {
            "mint": args.mint,
            "client_token": args.client_token,
            "escrow_keypair_path": args.escrow_keypair_path,
            "job_id": args.job_id,
            "expected_fragments": int(args.expected_fragments),
