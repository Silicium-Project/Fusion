{
  "schema_version": 1,
  "notes": "Budgets are CI guardrails for the active Network runtime; they are not performance claims.",
  "profiles": {
    "network_check": {
      "description": "Active Python/runtime stability check.",
      "command": ["./silicium", "check", "--scope", "platform", "--no-docker"],
      "timeout_sec": 900.0,
      "budgets": {
        "wall_sec": 480.0,
        "cpu_sec": 1200.0,
        "max_rss_kib": 3500000.0
      }
    },
    "pytest_core": {
      "description": "Cross-platform Python validation subset.",
      "command": ["python", "-m", "pytest", "tests/test_manifests.py"],
      "timeout_sec": 300.0,
      "budgets": {
        "wall_sec": 180.0,
        "cpu_sec": 400.0,
        "max_rss_kib": 1500000.0
      }
    },
    "pytest_core_linux": {
      "description": "Linux entrypoint and manifest validation subset.",
      "platforms": ["linux"],
      "command": ["python3", "-m", "pytest", "tests/test_entrypoint.py", "tests/test_manifests.py"],
      "timeout_sec": 420.0,
      "budgets": {
        "wall_sec": 240.0,
        "cpu_sec": 500.0,
        "max_rss_kib": 1800000.0
      }
    },
    "raytracer_native": {
      "description": "Native Rust raytracer workload tests.",
      "platforms": ["linux", "darwin", "windows"],
      "command": ["cargo", "test", "--manifest-path", "workloads/raytracer/native/Cargo.toml"],
      "timeout_sec": 600.0,
      "budgets": {
        "wall_sec": 300.0,
        "cpu_sec": 900.0,
        "max_rss_kib": 2000000.0
      }
    }
  }
}
