# ─── Base de données PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=silicium_database
POSTGRES_USER=silicium
POSTGRES_PASSWORD=change_me

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
JWT_SECRET_KEY=change_me

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Origines autorisées, séparées par des virgules. Utiliser * pour tout autoriser (dev uniquement).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Solana ────────────────────────────────────────────────────────────────────
# Devnet par défaut, remplacer par mainnet-beta en production
SILICIUM_SOLANA_RPC=https://api.devnet.solana.com
SILICIUM_SOLANA_PROGRAM_ID=

# ─── Serveur HTTP ──────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8080
