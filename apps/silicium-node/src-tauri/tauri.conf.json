{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silicium Node",
  "version": "0.2.9-dev.23",
  "identifier": "network.silicium.node",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Silicium Node",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/runtime"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh",
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "startMenuFolder": "Silicium"
      }
    }
  }
}
