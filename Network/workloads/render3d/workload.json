{
  "schema_version": 1,
  "id": "render3d",
  "name": "Silicium Render3D Demo Workload",
  "description": "Deterministic sphere renderer used by the Silicium demo. The network calls this through split, compute, verify and reassemble entrypoints.",
  "input": {
    "kind": "scene",
    "format": "json",
    "default_example": "Network/demo/render3d/scene.json"
  },
  "output": {
    "fragment_format": "ppm/p6",
    "result_format": "png"
  },
  "workload_ids": {
    "compute": "calcul/rendering/demo-render3d",
    "verify": "verification/rendering/demo-render3d",
    "fragment_compute": "calcul/rendering/demo-render3d-fragment",
    "fragment_verify": "verification/rendering/demo-render3d-fragment"
  },
  "entrypoints": {
    "split": "python split.py <scene.json> --output <split.json>",
    "compute": "python compute.py --scene <scene.json> --output <fragment.ppm> --y-start <start> --y-end <end>",
    "verify": "python verify.py --scene <scene.json> --result <fragment.ppm> --expected-hash <sha256>",
    "reassemble": "python reassemble.py --fragment <fragment-0.ppm> --fragment <fragment-1.ppm> --output <render.ppm> --png <render.png>"
  },
  "split_policy": {
    "kind": "recursive-horizontal-bands",
    "complexity_threshold": 60000,
    "max_depth": 4
  },
  "portability": {
    "windows": true,
    "linux": true,
    "requires_gpu": false
  }
}
