# Copy to Network\config\orchestrator.env and replace IPs before a real LAN run.
SILICIUM_ORCHESTRATOR_ID=orchestrator-1
SILICIUM_ORCHESTRATOR_HOST=192.168.1.10
SILICIUM_ORCHESTRATOR_PORT=46100

SILICIUM_WORKER_URL=http://192.168.1.11:46101
SILICIUM_VERIFIER_URL=http://192.168.1.12:46102
SILICIUM_MESH_KEY=demo-mesh

SILICIUM_MIN_COMPUTE_REPUTATION=50
SILICIUM_MIN_VERIFY_REPUTATION=40
SILICIUM_DEVNET_TRACE=1
SILICIUM_DEVNET_TX_DELAY_MS=2500
