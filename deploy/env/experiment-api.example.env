SILICIUM_EXPERIMENT_API_PORT=46110
SILICIUM_EXPERIMENT_EXPORT_DIR=/var/lib/silicium/network/orchestrator/export
SILICIUM_EXPERIMENT_SNAPSHOT_DIR=/var/lib/silicium/network/experiment-api/snapshots
SILICIUM_MCP_TOKEN=replace-with-a-long-random-token
SILICIUM_MCP_TOOL_ALLOWLIST=tools.silicium.*
SILICIUM_MCP_RESOURCE_ALLOWLIST=resources://silicium/*
