SILICIUM_DOWNLOADS_DIR=/var/lib/silicium/downloads
SILICIUM_DOWNLOAD_BASE_URL=https://vps-910c1dbc.vps.ovh.net/downloads
SILICIUM_DEV_VERSION=0.2.9-dev.24
SILICIUM_PROD_VERSION=0.2.17
SILICIUM_DEV_CHECK_INTERVAL_SECONDS=30
SILICIUM_PROD_CHECK_INTERVAL_SECONDS=21600
SILICIUM_UPDATE_SIGNING_KEY=/etc/silicium/update-signing-key.pem
SILICIUM_UPDATE_P2P_DIR=/var/lib/silicium/network/orchestrator/export/p2p
SILICIUM_UPDATE_GOSSIP_URL=http://127.0.0.1:46100/gossip/publish
SILICIUM_MESH_KEY=demo-mesh
SILICIUM_UPDATE_PUBLISHER_IDENTITY_KEY=/var/lib/silicium/update-publisher/peer_identity_ed25519.pem
SILICIUM_UPDATE_GOSSIP_REQUIRED=1
