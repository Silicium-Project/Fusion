POSTGRES_DB=silicium
POSTGRES_USER=silicium
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
# Production defaults. A development deployment resolves its own config/data
# roots from deploy/release/channels.json; use a separate ingress if both
# channels are hosted on the same machine.
SILICIUM_RELEASE_CHANNEL=prod
SILICIUM_RELEASE_VERSION=0.2.17
SILICIUM_RELEASE_BUILD=local
SILICIUM_COMPOSE_PROJECT_NAME=silicium
SILICIUM_RUNTIME_ROOT=/opt/silicium
SILICIUM_DATA_ROOT=/var/lib/silicium
SILICIUM_CONFIG_DIR=/etc/silicium
SILICIUM_BACKEND_HTTP_PORT=8080
SILICIUM_BACKEND_P2P_PORT=46102
SILICIUM_FRONTEND_HTTP_PORT=3000
SILICIUM_DASHBOARD_HTTP_PORT=5174
SILICIUM_REPUTATION_HTTP_PORT=9091
SILICIUM_ORCHESTRATOR_PORT=46100
SILICIUM_EXPERIMENT_EVENTS_PORT=9771
SILICIUM_TURN_PORT=3478
SILICIUM_TURN_TLS_PORT=5349
SILICIUM_TURN_RELAY_MIN_PORT=49160
SILICIUM_TURN_RELAY_MAX_PORT=49200
SILICIUM_BACKEND_NETWORK_NAME=silicium-backend
SILICIUM_FRONTEND_NETWORK_NAME=silicium-frontend
SILICIUM_PROXY_BIND_ADDRESS=0.0.0.0
SILICIUM_PROXY_HTTP_PORT=80
SILICIUM_PROXY_HTTPS_PORT=443
SILICIUM_TLS_ROOT=/etc/letsencrypt
SILICIUM_PUBLIC_ORCHESTRATOR_URL=https://vps-910c1dbc.vps.ovh.net/orchestrator
SILICIUM_CORS_ALLOWED_ORIGINS=https://vps-910c1dbc.vps.ovh.net
# Existing database name used by the one-time migration. Change if needed.
SOURCE_POSTGRES_DB=silicium
