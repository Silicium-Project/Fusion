# Public backend binding behind Nginx.
HOST=127.0.0.1
PORT=8080
CORS_ALLOWED_ORIGINS=https://silicium.example.com

# Release contract. The dev branch uses dev; main and version tags use prod.
SILICIUM_RELEASE_CHANNEL=prod
SILICIUM_RELEASE_VERSION=0.2.17
SILICIUM_RELEASE_BUILD=local

# PostgreSQL is required for the production backend.
DATABASE_URL=postgres://silicium:CHANGE_THIS_PASSWORD@127.0.0.1:5432/silicium?sslmode=disable

JWT_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

SILICIUM_NETWORK_ROOT=/opt/silicium/Network
SILICIUM_ORCHESTRATOR_EXPORT_DIR=/var/lib/silicium/network/orchestrator/export
SILICIUM_ORCHESTRATOR_NODE_ID=orchestrator-1
SILICIUM_SITE_STORAGE_DIR=/var/lib/silicium/site/jobs
SILICIUM_WORKLOAD_STORAGE_DIR=/var/lib/silicium/site/runtime
SILICIUM_DASHBOARD_URL=https://dashboard.silicium.example.com/

SILICIUM_ORCHESTRATOR_HOST=ORCHESTRATOR_PUBLIC_IP
SILICIUM_SEED_PEERS=http://127.0.0.1:46100
SILICIUM_CONTROL_URL=http://127.0.0.1:46100/gossip/publish
SILICIUM_ORCHESTRATOR_IDENTITY_KEY=/var/lib/silicium/network/orchestrator/backend-identity/peer_identity_ed25519.pem
SILICIUM_MESH_KEY=change-me-demo-mesh
SILICIUM_MIN_COMPUTE_REPUTATION=50
SILICIUM_MIN_VERIFY_REPUTATION=40

# Le flux ci-dessous est le flux réel Devnet (transactions + rémunération des
# workers). Laisser à 0 en exploitation tant que le wallet est absent/non
# financé; passer à 1 pour l'activer explicitement.
SILICIUM_DEVNET_TRACE=0
SILICIUM_DEVNET_TRACE_MODE=devnet
SILICIUM_DEVNET_TRACE_TIMEOUT_S=240
# Utilise uniquement par le mode full_demo.
SILICIUM_DEVNET_TX_DELAY_MS=2500
SILICIUM_SOLANA_RPC=https://api.devnet.solana.com
SILICIUM_SOLANA_PROGRAM_ID=A9bxX9KwPHFP8S4bMPWVzStpq4uMsC7BU15vw2J6Hnz2
SILICIUM_SOLANA_WALLET=/var/lib/silicium/solana/id.json
