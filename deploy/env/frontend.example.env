HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Release contract. CI injects the exact channel/version/build at runtime.
NUXT_PUBLIC_RELEASE_CHANNEL=prod
NUXT_PUBLIC_RELEASE_VERSION=0.2.17
NUXT_PUBLIC_RELEASE_BUILD=local

NUXT_PUBLIC_API_BASE=https://api.silicium.example.com
NUXT_PUBLIC_DEVNET_DASHBOARD_URL=https://dashboard.silicium.example.com/
NUXT_PUBLIC_ORCHESTRATOR_URL=https://vps-910c1dbc.vps.ovh.net/orchestrator
NUXT_PUBLIC_NODE_APP_WINDOWS_URL=/downloads/silicium-node-windows.exe
NUXT_PUBLIC_NODE_APP_WINDOWS_DEV_URL=/downloads/silicium-node-windows-dev.exe
NUXT_PUBLIC_NODE_APP_LINUX_DEV_URL=/downloads/silicium-node-linux-dev.AppImage
NUXT_PUBLIC_NODE_APP_LINUX_DEV_DEB_URL=/downloads/silicium-node-linux-dev.deb
NUXT_PUBLIC_NODE_APP_LINUX_DEV_RPM_URL=/downloads/silicium-node-linux-dev.rpm
NUXT_SILICIUM_MESH_KEY=change-me-demo-mesh
