SILICIUM_NODE_ID=orchestrator-1
SILICIUM_NODE_ROLES=resource,storage
SILICIUM_NODE_PORT=46100
SILICIUM_RELEASE_CHANNEL=prod
SILICIUM_APP_VERSION=0.2.17
SILICIUM_RELEASE_BUILD=local
SILICIUM_NODE_ADVERTISE_HOST=ORCHESTRATOR_PUBLIC_IP
# Stable rendezvous URL used by desktop nodes through the TLS reverse proxy.
SILICIUM_NODE_ADVERTISE_URL=https://vps-910c1dbc.vps.ovh.net/orchestrator
SILICIUM_PEER_SYNC_INTERVAL_S=5
SILICIUM_PEER_SYNC_FANOUT=8
SILICIUM_PEER_HTTP_MAX_WORKERS=32
SILICIUM_PEER_STALE_AFTER_S=15
SILICIUM_MESH_KEY=change-me-demo-mesh
SILICIUM_REPUTATION_SCORE=100
SILICIUM_EXPORT_DIR=/var/lib/silicium/network/orchestrator/export
SILICIUM_STATE_DIR=/var/lib/silicium/network/orchestrator/state
