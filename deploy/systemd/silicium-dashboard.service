[Unit]
Description=Silicium Devnet dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__SILICIUM_ROOT__/Network/silicium-layer-dashboard
ExecStart=/usr/bin/npm run preview -- --host 127.0.0.1 --port 5174
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
