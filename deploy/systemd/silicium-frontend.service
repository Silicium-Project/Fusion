[Unit]
Description=Silicium Nuxt frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__SILICIUM_ROOT__/Site/FrontEnd-main
EnvironmentFile=/etc/silicium/frontend.env
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
