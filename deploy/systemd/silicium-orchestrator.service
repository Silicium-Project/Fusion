[Unit]
Description=Silicium network orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__SILICIUM_ROOT__/Network
EnvironmentFile=/etc/silicium/orchestrator.env
ExecStart=/usr/bin/python3 __SILICIUM_ROOT__/Network/tools/bootstrap_orchestrator.py --bind 0.0.0.0 --port ${SILICIUM_NODE_PORT} --node-id ${SILICIUM_NODE_ID} --export-dir ${SILICIUM_EXPORT_DIR}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
