[Unit]
Description=Silicium network orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__SILICIUM_ROOT__/Network
EnvironmentFile=/etc/silicium/orchestrator.env
ExecStart=__SILICIUM_ROOT__/deploy/linux/start-orchestrator.sh __SILICIUM_ROOT__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
