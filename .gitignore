# Local IDE / tooling state
.vscode/
.pytest_cache/
tests/__pycache__/
.cache/
tools/**/build/
tools/experiments/splitter/splitter
tools/experiments/fragment-executor/fragment_executor
tools/worker/worker

# Experimental leftovers
tools/experiments/old_tests/

# Secrets generated for the reverse proxy (certificates/private keys)
infra/docker/reverse-proxy/certs/*.crt
infra/docker/reverse-proxy/certs/*.key
infra/docker/reverse-proxy/certs/*.pem
infra/docker/reverse-proxy/certs/*.pfx
infra/docker/reverse-proxy/certs/*.p12
infra/docker/reverse-proxy/certs/*.csr

# WireGuard peer configuration
infra/secure-stack/wireguard/config/
